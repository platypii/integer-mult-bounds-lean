theorem iter_succ_eq (wt v0 : List (List Bool)) (s m p w W K : ℕ) :
    nextWords v0 (outWords wt (ext s m (iter wt v0 s m p w W K)) s s m p w W s) w =
      iter wt v0 s m p w W (K + 1) := rfl

theorem outWords_width (wt us : List (List Bool)) (s t m p w W n : ℕ) (hwW : w ≤ W) :
    ∀ x ∈ outWords wt us s t m p w W n, x.length = W := by
  induction n with
  | zero => simp [outWords]
  | succ n ih =>
    intro x hx
    rw [GaussianLine.outWords_succ, List.mem_append] at hx
    rcases hx with hx | hx
    · exact ih x hx
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      · exact GaussianLine.accR_length _ _ _ _ _ _ _ _ _ hwW _
      · exact GaussianLine.accI_length _ _ _ _ _ _ _ _ _ hwW _

/-- The cost of one iteration. -/
def stepBound (s m p w W L : ℕ) : ℕ :=
  16 * (2 * (s + 2 * m + 1) * (W + 1)) + s * (2 * m + 1) * (w + 1) + 4 * s +
    s * (GaussianLine.outerBound p w W m L + 2) + 2 * s * (SubPass.bodyBound w W + 2) + 2 * L + 150

theorem flat_take_drop_le (recs : List (List (Fin (a + 4)))) (i n : ℕ) :
    (flat ((recs.drop i).take n)).length ≤ (flat recs).length :=
  (flat_take_le _ n).trans (flat_drop_le recs i)

theorem nextWords_shape (v0 es : List (List Bool)) (w : ℕ) (hv0w : ∀ x ∈ v0, x.length = w) :
    ∀ x ∈ nextWords v0 es w, x.length = w := by
  intro x hx
  simp only [nextWords, List.mem_map, List.mem_range] at hx
  obtain ⟨i, hi, rfl⟩ := hx
  have hv := hv0w _ (Resampling.NeumannWords.getD_mem' _ _ hi)
  rw [TwosComplement.addMod_length _ _ (by rw [TwosComplement.negWord_length, hv]; simp), hv]

