/-- The steps before the conditional append. -/
def prefixPart (q b n : ℕ) (hb : 1 ≤ b) (hbq1 : b + 1 ≤ q) := (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (copyV n q) (copyW n b)) (backCtr n q b)) retV) retW) (guardPart q b n)) retV) retW) retF) anyPart) eraseF) (inversePart q b n hb hbq1)) (togglePart q b n hb hbq1)) leftK)
/-- Append the destination words when flagged. -/
def trueChain := (seq (seq (seq (seq (seq rightK copyVt) copyWr) markedK) retVt) retWr)
def falseChain := (seq rightK markedK)
def condPart := branch (fun s => decide (s 0 = bitSymbol true)) trueChain falseChain
/-- Erase every scratch word. -/
def cleanupPart := (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq scanV eraseV) scanW) eraseW) scanW1) eraseW1) scanT) eraseT) scanV1) eraseV1) scanWr) eraseWr) scanVr) eraseVr) scanVt) eraseVt)
/-- The key routine. -/
def program (q b n : ℕ) (hb : 1 ≤ b) (hbq1 : b + 1 ≤ q) := seq (seq (prefixPart q b n hb hbq1) condPart) cleanupPart

end Parts

section Semantics

theorem field_cons (xs : List Bool) (s d : ℕ) :
    Gather.field xs s (d + 1) = xs.getD s false :: Gather.field xs (s + 1) d := by
  simp only [Gather.field, List.range_succ_eq_map, List.map_cons, List.map_map, add_zero]
  congr 1
  refine List.map_congr_left fun j _ => ?_
  simp only [Function.comp]
  congr 1
  omega

/-- Copying cells of a placed bit word from an offset. -/
theorem cells_field1 (f : ℤ → Fin 5) (p : ℤ) (bs : List Bool) (m d : ℕ) (h : m + d ≤ bs.length) :
    CopyCells.cells (putWord f p (bs.map bitSymbol)) (p + m) d = (Gather.field bs m d).map bitSymbol := by
  induction d generalizing m with
  | zero => rfl
  | succ d ih =>
    rw [CopyCells.cells, field_cons, List.map_cons, Gather.putWord_getD _ _ _ _ (by omega),
      show p + (m : ℤ) + 1 = p + ((m + 1 : ℕ) : ℤ) by push_cast; ring, ih (m + 1) (by omega)]
    cases bs.getD m false <;> simp [CopyCells.zeroFill, bitSymbol, blank]

theorem cells_field0 (f : ℤ → Fin 5) (p : ℤ) (bs : List Bool) (d : ℕ) (hd : d ≤ bs.length) :
    CopyCells.cells (putWord f p (bs.map bitSymbol)) p d = (Gather.field bs 0 d).map bitSymbol := by
  have := cells_field1 f p bs 0 d (by omega)
  simpa using this

theorem keyTape_update (x : Fin 5) :
    Function.update (FlagCopy.keyTape []) 0 x = FlagCopy.keyTape [x] := rfl

theorem keyTape_append1 (x : Fin 5) (ys : List (Fin 5)) :
    putWord (FlagCopy.keyTape [x]) 1 ys = FlagCopy.keyTape (x :: ys) := by
  have := putWord_append_forward (PartitionMarked.markedTape 0 []) 0 [x] ys
  simpa [FlagCopy.keyTape] using this

theorem keyTape_append2 (n q : ℕ) (x : Fin 5) (ys zs : List Bool) (hlen : ys.length = n * q) :
    putWord (FlagCopy.keyTape (x :: ys.map bitSymbol)) (1 + ↑n * ↑q) (zs.map bitSymbol) =
      FlagCopy.keyTape (x :: (ys ++ zs).map bitSymbol) := by
  have := putWord_append_forward (PartitionMarked.markedTape 0 []) 0 (x :: ys.map bitSymbol)
    (zs.map bitSymbol)
  rw [show (0 : ℤ) + ↑(x :: ys.map bitSymbol).length = 1 + ↑n * ↑q by simp [hlen]; ring] at this
  simpa [FlagCopy.keyTape, List.map_append] using this

theorem keyWord_interior (flag : Bool) (bits : List Bool) :
    ∀ x ∈ bitSymbol flag :: bits.map bitSymbol, x ≠ blank ∧ x ≠ PartitionMarked.marker := by
  intro x hx
  simp only [List.mem_cons, List.mem_map] at hx
  rcases hx with rfl | ⟨b, _, rfl⟩
  · cases flag <;> decide
  · cases b <;> decide

theorem keyWord_interior_single (flag : Bool) :
    ∀ x ∈ [bitSymbol flag], x ≠ blank ∧ x ≠ PartitionMarked.marker := by
  intro x hx
  simp only [List.mem_singleton] at hx
  subst hx
  cases flag <;> decide

end Semantics

/-- The cost of the steps before the conditional append. -/
def prefixCost (q b n : ℕ) (hb : 1 ≤ b) (hbq1 : b + 1 ≤ q) : ℕ :=
  CopyCells.cost (n * q) + 1 + CopyCells.cost (n * b) + 1 + (n * q + n * b) * (1 + 1) + 1 +
  (n * q + 2) + 1 + (n * b + 2) + 1 + GuardGadget.cost q b n + 1 + (n * q + 2) + 1 + (n * b + 2) + 1 +
  (3 * n + 2) + 1 + (3 * n + 1) + 1 + (3 * n + 2) + 1 + PackedInverse.cost q b hb hbq1 n + 1 +
  PackedLine.lineCost (PackedArith.controlsAt q b hb hbq1) n (n * q) + 1 + 1
def trueCost (q b n : ℕ) : ℕ :=
  1 + 1 + n * q + 1 + n * b + 1 + (1 + n * q + n * b + 2) + 1 + (n * q + 2) + 1 + (n * b + 2)
def falseCost : ℕ := 1 + 1 + (1 + 2)
def cleanCost (q b n : ℕ) : ℕ :=
  (n * q + 1 + (n * q + 2)) + 1 + (n * b + 1 + (n * b + 2)) + 1 + (n * b + 1 + (n * b + 2)) + 1 +
  (n * q + 1 + (n * q + 2)) + 1 + (n * q + 1 + (n * q + 2)) + 1 + (n * b + 1 + (n * b + 2)) + 1 +
  (n * q + 1 + (n * q + 2)) + 1 + (n * q + 1 + (n * q + 2))
/-- The total cost. -/
def cost (q b n : ℕ) (hb : 1 ≤ b) (hbq1 : b + 1 ≤ q) : ℕ :=
  prefixCost q b n hb hbq1 + 1 + (max (trueCost q b n) falseCost + 1) + 1 + cleanCost q b n

