/-- The centre advances exactly when the counter crosses the modulus. -/
theorem centre_succ (s t k : ℕ) (sW tW : List Bool) (hsv : Counter.value sW = s)
    (htv : Counter.value tW = t) (hst : s ≤ t) (hs : 0 < s) (hsl : sW.length ≤ tW.length + 1) :
    centre s t (k + 1) = centre s t k + if OrderedSelect.sel sW tW [] k then 1 else 0 := by
  rw [OrderedSelect.sel_eq sW tW [] (by rw [hsv, htv]; omega) (by rw [htv]; simp [Counter.value]; omega)
    hsl (by simp) k]
  simp only [Counter.value, zero_add, hsv, htv]
  unfold centre
  have ht : 0 < t := by omega
  have hdm := Nat.div_add_mod (s * k) t
  have hlt := Nat.mod_lt (s * k) ht
  generalize hr : s * k % t = r at hdm hlt ⊢
  generalize hq : s * k / t = q at hdm ⊢
  rw [Nat.mul_succ, show s * k + s = t * q + (r + s) by omega, Nat.mul_add_div ht]
  split_ifs with h
  · simp only [decide_eq_true_eq] at h
    rw [show r + s = t * 1 + (r + s - t) by omega, Nat.mul_add_div ht, Nat.div_eq_of_lt (by omega)]
  · simp only [decide_eq_true_eq, not_le] at h
    rw [Nat.div_eq_of_lt (by omega)]

