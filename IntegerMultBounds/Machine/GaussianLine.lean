    intro k hk h0
    have := getD_length wtWords w hwt (k * (2 * m + 1) + 0) (by rw [hwtl]; nlinarith)
    rw [h0] at this; simp at this; omega
  have h := while_chain_hoare (outerBody (a := a)) (fun sy => decide (sy 0 ≠ blank)) (fun k => Y wtWords uWords s t m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc hw hpw hwW hwt hu hwtl hul hst hs hsv htv hsl k 0)
    (fun _ => outerBound p w W m tW.length) t (fun k hk => outer_hoare (a := a) wtWords uWords s t m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc hw hpw hwW hwt hu hwtl hul hst hs hsv htv hsl k hk) (fun k hk => ?_) ?_
