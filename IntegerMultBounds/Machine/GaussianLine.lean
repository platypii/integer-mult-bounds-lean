/-- The line machine: `t` outputs, each the exact window sum of truncated
products, within `t` times the per-output bound. -/
theorem line_hoare (wtWords uWords : List (List Bool)) (s t m p w W : ℕ) (sW tW : List Bool)
    (pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc : ℤ)
    (hw : 1 ≤ w) (hpw : p ≤ w) (hwW : w ≤ W) (hwt : ∀ x ∈ wtWords, x.length = w)
    (hu : ∀ x ∈ uWords, x.length = w) (hwtl : wtWords.length = t * (2 * m + 1))
    (hul : 2 * (s + 2 * m + 1) ≤ uWords.length) (hst : s ≤ t) (hs : 0 < s)
    (hsv : Counter.value sW = s) (htv : Counter.value tW = t) (hsl : sW.length ≤ tW.length + 1) :
    HoareTime (program (a := a)) (fun v => v = Y wtWords uWords s t m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc hw hpw hwW hwt hu hwtl hul hst hs hsv htv hsl 0 0)
