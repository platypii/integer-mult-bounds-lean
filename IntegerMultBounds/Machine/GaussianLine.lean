import IntegerMultBounds.Machine.FixedMul
import IntegerMultBounds.Machine.SignExtendAdd
import IntegerMultBounds.Machine.RecordTape
import IntegerMultBounds.Machine.LoopChain

/-! The Gaussian window sums of the resampling map `S̃'` on tapes. The weights
and the (cyclically extended) input words are blank-separated fixed-point
words on two tapes; for each output the machine multiplies the `2m + 1`
weights of its window with the real and imaginary words of the `2m + 1`
input records, accumulating the truncated products exactly into two wider
accumulators, writes the two accumulator words to the output, rewinds the
input by the window and advances it by the centre increment, which a modular
counter decides. Twenty-two tapes; the loops are driven by unary rulers and
the input exhaustion, so the finite control is fixed. -/

namespace IntegerMultBounds.Machine.GaussianLine

open OrderedSelect (inTape bg start flat inTape_repr bg_blank bg_left start_succ getD_map)
open TwosComplement (addMod)
open FixedMul (ruler result ruler_nonblank ruler_length)
open BinaryAccumulate (sumWord)
open BinaryDecrease (diffWord)

variable {a : ℕ}

/-- The bank: weights, input, the twelve-tape multiply's ten scratch and
ruler tapes (two outputs), two accumulators, the output, the window ruler,
the accumulator-width ruler, the counter with its two constants, and the
comparison flag. -/
def bank (f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18 f19 f20 f21 : ℤ → Fin (a + 4))
    (p0 p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15 p16 p17 p18 p19 p20 p21 : ℤ) : Tapes 22 a :=
  ⟨fun i => if i = 0 then p0 else if i = 1 then p1 else if i = 2 then p2 else if i = 3 then p3
    else if i = 4 then p4 else if i = 5 then p5 else if i = 6 then p6 else if i = 7 then p7
    else if i = 8 then p8 else if i = 9 then p9 else if i = 10 then p10 else if i = 11 then p11
    else if i = 12 then p12 else if i = 13 then p13 else if i = 14 then p14 else if i = 15 then p15
    else if i = 16 then p16 else if i = 17 then p17 else if i = 18 then p18 else if i = 19 then p19
    else if i = 20 then p20 else p21,
   fun i => if i = 0 then f0 else if i = 1 then f1 else if i = 2 then f2 else if i = 3 then f3
    else if i = 4 then f4 else if i = 5 then f5 else if i = 6 then f6 else if i = 7 then f7
    else if i = 8 then f8 else if i = 9 then f9 else if i = 10 then f10 else if i = 11 then f11
    else if i = 12 then f12 else if i = 13 then f13 else if i = 14 then f14 else if i = 15 then f15
    else if i = 16 then f16 else if i = 17 then f17 else if i = 18 then f18 else if i = 19 then f19
    else if i = 20 then f20 else f21⟩

section Words

/-- Bit words as records. -/
def wordRecs (ws : List (List Bool)) : List (List (Fin (a + 4))) := ws.map (List.map bitSymbol)

theorem wordRecs_length (ws : List (List Bool)) : (wordRecs (a := a) ws).length = ws.length :=
  List.length_map _

theorem word_repr (ws : List (List Bool)) (i : ℕ) (hi : i < ws.length) :
    inTape (wordRecs (a := a) ws) =
      putWord (bg (wordRecs (a := a) ws) i) (start (wordRecs (a := a) ws) i) ((ws.getD i []).map bitSymbol) := by
  rw [inTape_repr _ i (by rw [wordRecs_length]; exact hi), wordRecs, getD_map]

theorem getD_length (ws : List (List Bool)) (w : ℕ) (hws : ∀ x ∈ ws, x.length = w) (i : ℕ)
    (hi : i < ws.length) : (ws.getD i []).length = w := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]
  exact hws _ (List.getElem_mem hi)

theorem bg_right (ws : List (List Bool)) (w : ℕ) (hws : ∀ x ∈ ws, x.length = w) (i : ℕ)
    (hi : i < ws.length) : bg (wordRecs (a := a) ws) i ((start (wordRecs (a := a) ws) i : ℤ) + ↑w) = blank := by
  have := bg_blank (wordRecs (a := a) ws) i
  rw [wordRecs, getD_map, List.length_map, getD_length ws w hws i hi] at this
  exact this

theorem bg_right_map (ws : List (List Bool)) (w : ℕ) (hws : ∀ x ∈ ws, x.length = w) (i : ℕ)
    (hi : i < ws.length) :
    bg (wordRecs (a := a) ws) i ((start (wordRecs (a := a) ws) i : ℤ) +
      ↑((ws.getD i []).map (bitSymbol (a := a))).length) = blank := by
  rw [List.length_map, getD_length ws w hws i hi]; exact bg_right ws w hws i hi

theorem bg_left' (ws : List (List Bool)) (i : ℕ) (hi : i < ws.length) :
    bg (wordRecs (a := a) ws) i ((start (wordRecs (a := a) ws) i : ℤ) - 1) = blank :=
  bg_left _ i (by rw [wordRecs_length]; exact hi)

theorem start_next (ws : List (List Bool)) (w : ℕ) (hws : ∀ x ∈ ws, x.length = w) (i : ℕ)
    (hi : i < ws.length) :
    (start (wordRecs (a := a) ws) i : ℤ) + ↑w + 1 = start (wordRecs (a := a) ws) (i + 1) := by
  rw [start_succ _ i (by rw [wordRecs_length]; exact hi), wordRecs, getD_map, List.length_map,
    getD_length ws w hws i hi]
  push_cast; ring

theorem back_pos (ws : List (List Bool)) (w : ℕ) (hws : ∀ x ∈ ws, x.length = w) (i : ℕ)
    (hi : i < ws.length) :
    (start (wordRecs (a := a) ws) i : ℤ) + ↑((ws.getD i []).map (bitSymbol (a := a))).length + 1 =
      start (wordRecs (a := a) ws) (i + 1) := by
  rw [List.length_map, getD_length ws w hws i hi]; exact start_next ws w hws i hi

theorem ruler_read (q : ℤ) (n i : ℕ) (hi : i < n) :
    putWord (fun _ => (blank : Fin (a + 4))) q (ruler n) (q + ↑i) ≠ blank :=
  ruler_nonblank n _ (ReturnOrigin.putWord_mem _ _ _ _ ⟨by omega, by rw [ruler_length]; omega⟩)

theorem cells_zero (q : ℤ) (W : ℕ) :
    CopyCells.cells (fun _ => (blank : Fin (a + 4))) q W = (List.replicate W false).map bitSymbol := by
  rw [CopyCells.cells_blank, List.map_replicate]

theorem ruler_end (q : ℤ) (n : ℕ) : putWord (fun _ => (blank : Fin (a + 4))) q (ruler n) (q + ↑n) = blank := by
  rw [putWord_outside _ _ _ _ (Or.inr (by rw [ruler_length]))]

/-- The window centre `⌊sk/t⌋`. -/
def centre (s t k : ℕ) : ℕ := s * k / t

/-- The real accumulator after `i` terms of window `k`. -/
def accR (wtWords uWords : List (List Bool)) (s t m p w W k : ℕ) : ℕ → List Bool
  | 0 => List.replicate W false
  | i + 1 => addMod (result (wtWords.getD (k * (2 * m + 1) + i) [])
      (uWords.getD (2 * centre s t k + 2 * i) []) p w) (accR wtWords uWords s t m p w W k i)

/-- The imaginary accumulator after `i` terms of window `k`. -/
def accI (wtWords uWords : List (List Bool)) (s t m p w W k : ℕ) : ℕ → List Bool
  | 0 => List.replicate W false
  | i + 1 => addMod (result (wtWords.getD (k * (2 * m + 1) + i) [])
      (uWords.getD (2 * centre s t k + 2 * i + 1) []) p w) (accI wtWords uWords s t m p w W k i)

theorem accR_succ (wtWords uWords : List (List Bool)) (s t m p w W k i : ℕ) :
    accR wtWords uWords s t m p w W k (i + 1) = addMod (result (wtWords.getD (k * (2 * m + 1) + i) [])
      (uWords.getD (2 * centre s t k + 2 * i) []) p w) (accR wtWords uWords s t m p w W k i) := rfl

theorem accI_succ (wtWords uWords : List (List Bool)) (s t m p w W k i : ℕ) :
    accI wtWords uWords s t m p w W k (i + 1) = addMod (result (wtWords.getD (k * (2 * m + 1) + i) [])
      (uWords.getD (2 * centre s t k + 2 * i + 1) []) p w) (accI wtWords uWords s t m p w W k i) := rfl

theorem accR_zero (wtWords uWords : List (List Bool)) (s t m p w W k : ℕ) :
    accR wtWords uWords s t m p w W k 0 = List.replicate W false := rfl

theorem accI_zero (wtWords uWords : List (List Bool)) (s t m p w W k : ℕ) :
    accI wtWords uWords s t m p w W k 0 = List.replicate W false := rfl

theorem result_length (x y : List Bool) (p w : ℕ) : (result x y p w).length = w := by
  unfold result
  split_ifs <;> simp [TwosComplement.negWord_length]

theorem accR_length (wtWords uWords : List (List Bool)) (s t m p w W k : ℕ) (hwW : w ≤ W) (i : ℕ) :
    (accR wtWords uWords s t m p w W k i).length = W := by
  induction i with
  | zero => simp [accR]
  | succ i ih => rw [accR, TwosComplement.addMod_length _ _ (by rw [result_length, ih]; exact hwW), ih]

theorem accI_length (wtWords uWords : List (List Bool)) (s t m p w W k : ℕ) (hwW : w ≤ W) (i : ℕ) :
    (accI wtWords uWords s t m p w W k i).length = W := by
  induction i with
  | zero => simp [accI]
  | succ i ih => rw [accI, TwosComplement.addMod_length _ _ (by rw [result_length, ih]; exact hwW), ih]

/-- The output words of the first `k` windows. -/
def outWords (wtWords uWords : List (List Bool)) (s t m p w W : ℕ) : ℕ → List (List Bool)
  | 0 => []
  | k + 1 => outWords wtWords uWords s t m p w W k ++
      [accR wtWords uWords s t m p w W k (2 * m + 1), accI wtWords uWords s t m p w W k (2 * m + 1)]

theorem outWords_succ (wtWords uWords : List (List Bool)) (s t m p w W k : ℕ) :
    outWords wtWords uWords s t m p w W (k + 1) = outWords wtWords uWords s t m p w W k ++
      [accR wtWords uWords s t m p w W k (2 * m + 1), accI wtWords uWords s t m p w W k (2 * m + 1)] := rfl

end Words

