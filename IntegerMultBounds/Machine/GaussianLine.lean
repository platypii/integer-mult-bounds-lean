theorem putWord_sep (q : ℤ) (A B : List (Fin (a + 4))) :
    putWord (putWord (fun _ => blank) q A) (q + ↑A.length + 1) B = putWord (fun _ => blank) q (A ++ [blank] ++ B) := by
  rw [show (q + ↑A.length + 1 : ℤ) = q + ↑(A ++ [blank]).length by simp; ring,
    ← putWord_append_forward (fun _ => blank) q (A ++ [blank]) B, OrderedSelect.putWord_blank_snoc]

/-- The output tape after appending the two accumulator words. -/
theorem out_canon (ws : List (List Bool)) (r1 r2 : List Bool) (W : ℕ) (hr1 : r1.length = W) (hr2 : r2.length = W)
    (pOut : ℤ) :
    putWord (putWord (fun _ => (blank : Fin (a + 4))) pOut (flat (wordRecs ws) ++ r1.map bitSymbol))
      (pOut + ↑(flat (wordRecs (a := a) ws)).length + ↑W + 1) (r2.map bitSymbol) =
      putWord (fun _ => blank) pOut (flat (wordRecs (ws ++ [r1, r2]))) ∧
    (pOut + ↑(flat (wordRecs (a := a) ws)).length + ↑W + 1 + ↑W + 1 : ℤ) =
      pOut + ↑(flat (wordRecs (a := a) (ws ++ [r1, r2]))).length := by
  have hflat : flat (wordRecs (a := a) (ws ++ [r1, r2])) =
      flat (wordRecs ws) ++ r1.map bitSymbol ++ [blank] ++ r2.map bitSymbol ++ [blank] := by
    simp [wordRecs, OrderedSelect.flat, List.flatten_append]
  constructor
  · have hpos : (pOut + ↑(flat (wordRecs (a := a) ws)).length + ↑W + 1 : ℤ) =
        pOut + ↑(flat (wordRecs (a := a) ws) ++ r1.map bitSymbol).length + 1 := by
      simp [hr1]; ring
    rw [hflat, hpos, putWord_sep, OrderedSelect.putWord_blank_snoc]
  · rw [hflat]; simp [hr1, hr2]; ring

/-- One output: the whole body carries the bank before window `k` to the bank
before window `k + 1`. -/
def outerBound (p w W m L : ℕ) : ℕ :=
  (2 * m + 1) * (bodyBound p w W + 2) + partABound m W + (2 * m + 1) * (rewindBodyBound w + 2) +
    2 * m + 12 * L + 8 * w + 70

