private theorem difference_hoare (q P G B e r : ℕ) (_hq : 2 ≤ q) (hr : r ≤ e)
    (hs : Fin 5 → List Bool) (hv : ∀ i, Counter.value (hs i) = originalValues P G B e r i)
    (hc : ∀ i, GrowingCounterData.Canonical (hs i)) :
    HoareTime (differenceProgram (a := a)) (fun v => v = input hs)
      (fun v => v = state q P G B e r 1 hs) (6*e+27) := by
  have hx : Counter.value (hs 3) = e := hv 3
  have hy : Counter.value (hs 4) = r := hv 4
  have h := BinaryDescriptorDifference.difference_linear (a := a) (hs 3) (hs 4)
    (by rw [hx,hy]; exact hr) (hc 3) (hc 4)
  rw [hx,hy] at h
  apply placed_exact differencePlacement (input hs) (state q P G B e r 1 hs)
    (BinaryDescriptorDifference.input (hs 3) (hs 4)) (BinaryDescriptorDifference.output (hs 3) (hs 4) (RecursiveChildQuotientsConstant.bits (e-r))) ?_ ?_ ?_ h
  · exact difference_active_input (a := a) q P G B e r hs
  · exact difference_active_output (a := a) q P G B e r hs
  · exact difference_extra (a := a) q P G B e r hs

private theorem high_hoare (q P G B e r : ℕ) (hq : 2 ≤ q) (_hr : r ≤ e)
    (hs : Fin 5 → List Bool) (hv : ∀ i, Counter.value (hs i) = originalValues P G B e r i)
    (hc : ∀ i, GrowingCounterData.Canonical (hs i)) :
    HoareTime (highProgram (a := a) q) (fun v => v = state q P G B e r 1 hs)
      (fun v => v = state q P G B e r 2 hs) (FixedBasePowerDescriptor.constant q*q^r) := by
  have h := FixedBasePowerDescriptor.constructs_linear (q := a) q r hq (hs 4)
    (hv 4) (hc 4)
  apply placed_exact highPlacement (state q P G B e r 1 hs) (state q P G B e r 2 hs)
    (FixedBasePowerDescriptor.input (hs 4)) (FixedBasePowerDescriptor.output q r (hs 4)) ?_ ?_ ?_ h
  · exact high_active_input (a := a) q P G B e r hs
  · exact high_active_output (a := a) q P G B e r hs
  · exact high_extra (a := a) q P G B e r hs

private theorem low_hoare (q P G B e r : ℕ) (hq : 2 ≤ q) (_hr : r ≤ e)
    (hs : Fin 5 → List Bool) (_hv : ∀ i, Counter.value (hs i) = originalValues P G B e r i)
    (_hc : ∀ i, GrowingCounterData.Canonical (hs i)) :
    HoareTime (lowProgram (a := a) q) (fun v => v = state q P G B e r 2 hs)
      (fun v => v = state q P G B e r 3 hs) (FixedBasePowerDescriptor.constant q*q^(e-r)) := by
  have h := FixedBasePowerDescriptor.constructs_linear (q := a) q (e-r) hq (RecursiveChildQuotientsConstant.bits (e-r))
    (RecursiveChildQuotientsConstant.bits_value _) (RecursiveChildQuotientsConstant.bits_canonical _)
  apply placed_exact lowPlacement (state q P G B e r 2 hs) (state q P G B e r 3 hs)
    (FixedBasePowerDescriptor.input (RecursiveChildQuotientsConstant.bits (e-r))) (FixedBasePowerDescriptor.output q (e-r) (RecursiveChildQuotientsConstant.bits (e-r))) ?_ ?_ ?_ h
  · exact low_active_input (a := a) q P G B e r hs
  · exact low_active_output (a := a) q P G B e r hs
  · exact low_extra (a := a) q P G B e r hs

private theorem prefix_hoare (q P G B e r : ℕ) (hq : 2 ≤ q) (_hr : r ≤ e)
    (hs : Fin 5 → List Bool) (hv : ∀ i, Counter.value (hs i) = originalValues P G B e r i)
    (hc : ∀ i, GrowingCounterData.Canonical (hs i)) :
    HoareTime (prefixProgram (a := a)) (fun v => v = state q P G B e r 3 hs)
      (fun v => v = state q P G B e r 4 hs) (53*(P*q^r)+28) := by
  have hn : Counter.value (hs 0) = P := hv 0
  have hw := GrowingCounterData.canonical_width (FixedBasePowerStep.bits q r)
    (FixedBasePowerStep.bits_canonical q r)
  rw [FixedBasePowerStep.bits_value] at hw
  have hh := GrowingCounterData.canonical_width (hs 0) (hc 0)
  rw [hn] at hh
  have h := BoundedProductDescriptor.construct_hoare (q := a) (FixedBasePowerStep.bits q r)
    (hs 0) P (q^r) P (pow_pos (by omega : 0 < q) _) (FixedBasePowerStep.bits_value _ _) hn le_rfl
    (hw.trans (Nat.add_le_add_right (Nat.log2_le_self _) 1))
    (hh.trans (Nat.add_le_add_right (Nat.log2_le_self _) 1))
  apply placed_exact prefixPlacement (state q P G B e r 3 hs) (state q P G B e r 4 hs)
    (BoundedProductDescriptor.input (FixedBasePowerStep.bits q r) (hs 0)) (BoundedProductDescriptor.output (FixedBasePowerStep.bits q r) (hs 0) P (q^r)) ?_ ?_ ?_ h
  · exact prefix_active_input (a := a) q P G B e r hs
  · exact prefix_active_output (a := a) q P G B e r hs
  · exact prefix_extra (a := a) q P G B e r hs

private theorem gap_hoare (q P G B e r : ℕ) (hq : 2 ≤ q) (_hr : r ≤ e)
    (hs : Fin 5 → List Bool) (hv : ∀ i, Counter.value (hs i) = originalValues P G B e r i)
    (hc : ∀ i, GrowingCounterData.Canonical (hs i)) :
    HoareTime (gapProgram (a := a)) (fun v => v = state q P G B e r 4 hs)
      (fun v => v = state q P G B e r 5 hs) (53*(G*q^(e-r))+28) := by
  have hn : Counter.value (hs 1) = G := hv 1
  have hw := GrowingCounterData.canonical_width (FixedBasePowerStep.bits q (e-r))
    (FixedBasePowerStep.bits_canonical q (e-r))
  rw [FixedBasePowerStep.bits_value] at hw
  have hh := GrowingCounterData.canonical_width (hs 1) (hc 1)
  rw [hn] at hh
  have h := BoundedProductDescriptor.construct_hoare (q := a) (FixedBasePowerStep.bits q (e-r))
    (hs 1) G (q^(e-r)) G (pow_pos (by omega : 0 < q) _) (FixedBasePowerStep.bits_value _ _) hn le_rfl
    (hw.trans (Nat.add_le_add_right (Nat.log2_le_self _) 1))
    (hh.trans (Nat.add_le_add_right (Nat.log2_le_self _) 1))
  apply placed_exact gapPlacement (state q P G B e r 4 hs) (state q P G B e r 5 hs)
    (BoundedProductDescriptor.input (FixedBasePowerStep.bits q (e-r)) (hs 1)) (BoundedProductDescriptor.output (FixedBasePowerStep.bits q (e-r)) (hs 1) G (q^(e-r))) ?_ ?_ ?_ h
  · exact gap_active_input (a := a) q P G B e r hs
  · exact gap_active_output (a := a) q P G B e r hs
  · exact gap_extra (a := a) q P G B e r hs

private theorem suffix_hoare (q P G B e r : ℕ) (hq : 2 ≤ q) (_hr : r ≤ e)
    (hs : Fin 5 → List Bool) (hv : ∀ i, Counter.value (hs i) = originalValues P G B e r i)
    (hc : ∀ i, GrowingCounterData.Canonical (hs i)) :
    HoareTime (suffixProgram (a := a)) (fun v => v = state q P G B e r 5 hs)
      (fun v => v = state q P G B e r 6 hs) (53*(B*q^(e-r))+28) := by
  have hn : Counter.value (hs 2) = B := hv 2
  have hw := GrowingCounterData.canonical_width (FixedBasePowerStep.bits q (e-r))
    (FixedBasePowerStep.bits_canonical q (e-r))
  rw [FixedBasePowerStep.bits_value] at hw
  have hh := GrowingCounterData.canonical_width (hs 2) (hc 2)
  rw [hn] at hh
  have h := BoundedProductDescriptor.construct_hoare (q := a) (FixedBasePowerStep.bits q (e-r))
    (hs 2) B (q^(e-r)) B (pow_pos (by omega : 0 < q) _) (FixedBasePowerStep.bits_value _ _) hn le_rfl
    (hw.trans (Nat.add_le_add_right (Nat.log2_le_self _) 1))
    (hh.trans (Nat.add_le_add_right (Nat.log2_le_self _) 1))
  apply placed_exact suffixPlacement (state q P G B e r 5 hs) (state q P G B e r 6 hs)
    (BoundedProductDescriptor.input (FixedBasePowerStep.bits q (e-r)) (hs 2)) (BoundedProductDescriptor.output (FixedBasePowerStep.bits q (e-r)) (hs 2) B (q^(e-r))) ?_ ?_ ?_ h
  · exact suffix_active_input (a := a) q P G B e r hs
  · exact suffix_active_output (a := a) q P G B e r hs
  · exact suffix_extra (a := a) q P G B e r hs

def cost (q P G B e r : ℕ) :=
  6*e+27+FixedBasePowerDescriptor.constant q*q^r+
    FixedBasePowerDescriptor.constant q*q^(e-r)+53*(P*q^r)+28+
    (53*(G*q^(e-r))+28)+(53*(B*q^(e-r))+28)+5

/-- All six generated controls arise from physical subprograms, while the
five original headers survive and every arithmetic tape returns blank. -/
theorem construct_hoare (q P G B e r : ℕ) (hq : 2 ≤ q) (hr : r ≤ e)
    (hs : Fin 5 → List Bool) (hv : ∀ i, Counter.value (hs i) = originalValues P G B e r i)
    (hc : ∀ i, GrowingCounterData.Canonical (hs i)) :
    HoareTime (program (a := a) q) (fun v => v = input hs)
      (fun v => v = output q P G B e r hs) (cost q P G B e r) := by
  have h := (((((difference_hoare (a := a) q P G B e r hq hr hs hv hc).seq
    (high_hoare (a := a) q P G B e r hq hr hs hv hc)).seq
    (low_hoare (a := a) q P G B e r hq hr hs hv hc)).seq
    (prefix_hoare (a := a) q P G B e r hq hr hs hv hc)).seq
    (gap_hoare (a := a) q P G B e r hq hr hs hv hc)).seq
    (suffix_hoare (a := a) q P G B e r hq hr hs hv hc)
  exact h.consequence (fun _ h => h) (fun _ h => h) (by unfold cost; omega)

def linearConstant (q : ℕ) := 2*FixedBasePowerDescriptor.constant q+281

theorem cost_le (q P G B e r V : ℕ) (hV : 0 < V) (he : e ≤ V)
    (hvalues : ∀ i, values q P G B e r i ≤ V) :
    cost q P G B e r ≤ linearConstant q*V := by
  have hhi := Nat.mul_le_mul_left (FixedBasePowerDescriptor.constant q) (hvalues 1)
  have hlo := Nat.mul_le_mul_left (FixedBasePowerDescriptor.constant q) (hvalues 2)
  have hp : P*q^r ≤ V := hvalues 3
  have hg : G*q^(e-r) ≤ V := hvalues 4
  have hb : B*q^(e-r) ≤ V := hvalues 5
  change FixedBasePowerDescriptor.constant q*q^r ≤ FixedBasePowerDescriptor.constant q*V at hhi
  change FixedBasePowerDescriptor.constant q*q^(e-r) ≤ FixedBasePowerDescriptor.constant q*V at hlo
  unfold cost linearConstant
  simp only [Nat.add_mul,Nat.mul_assoc]
  omega

def dataVolume (q P G B e : ℕ) := P*G*B*q^(2*e)

private theorem width_power (q e : ℕ) (hq : 2 ≤ q) : e+1 ≤ q^e := by
  induction e with
  | zero => simp
  | succ e ih =>
    rw [pow_succ]
    have hp : 0 < q^e := pow_pos (by omega) _
    nlinarith

theorem data_volume_bounds (q P G B e r : ℕ) (hq : 2 ≤ q) (hr : r ≤ e)
    (hP : 0 < P) (hG : 0 < G) (hB : 0 < B) :
    0 < dataVolume q P G B e ∧ e ≤ dataVolume q P G B e ∧
      ∀ i, values q P G B e r i ≤ dataVolume q P G B e := by
  have houter : 0 < P*G*B := Nat.mul_pos (Nat.mul_pos hP hG) hB
  have hpow : 0 < q^(2*e) := pow_pos (by omega) _
  have hbase : q^(2*e) ≤ dataVolume q P G B e := by
    exact Nat.le_mul_of_pos_left _ houter
  have hepow := width_power q e hq
  have hep : q^e ≤ q^(2*e) := Nat.pow_le_pow_right (by omega : 0 < q) (by omega)
  have hp : q^r ≤ q^(2*e) := Nat.pow_le_pow_right (by omega : 0 < q) (by omega)
  have hl : q^(e-r) ≤ q^(2*e) := Nat.pow_le_pow_right (by omega : 0 < q) (by omega)
  have hPouter : P ≤ P*G*B := (Nat.le_mul_of_pos_right _ hG).trans (Nat.le_mul_of_pos_right _ hB)
  have hGouter : G ≤ P*G*B := by
    have h := (Nat.le_mul_of_pos_right G hP).trans (Nat.le_mul_of_pos_right _ hB)
    simpa only [Nat.mul_comm G P] using h
  have hBouter : B ≤ P*G*B := by
    have h := (Nat.le_mul_of_pos_right B hP).trans (Nat.le_mul_of_pos_right _ hG)
    convert h using 1; ring
  refine ⟨Nat.mul_pos houter hpow,by omega,?_⟩
  intro i
  fin_cases i
  · change e-r ≤ _; omega
  · exact hp.trans hbase
  · exact hl.trans hbase
  · exact Nat.mul_le_mul hPouter hp
  · exact Nat.mul_le_mul hGouter hl
  · exact Nat.mul_le_mul hBouter hl

theorem construct_linear (q P G B e r : ℕ) (hq : 2 ≤ q) (hr : r ≤ e)
    (hP : 0 < P) (hG : 0 < G) (hB : 0 < B)
    (hs : Fin 5 → List Bool) (hv : ∀ i, Counter.value (hs i) = originalValues P G B e r i)
    (hc : ∀ i, GrowingCounterData.Canonical (hs i)) :
    HoareTime (program (a := a) q) (fun v => v = input hs)
      (fun v => v = output q P G B e r hs) (linearConstant q*dataVolume q P G B e) := by
  have hb := data_volume_bounds q P G B e r hq hr hP hG hB
  exact (construct_hoare (a := a) q P G B e r hq hr hs hv hc).consequence
    (fun _ h => h) (fun _ h => h) (cost_le q P G B e r _ hb.1 hb.2.1 hb.2.2)


end
end IntegerMultBounds.Machine.ArbitraryWidthHighDimensions
