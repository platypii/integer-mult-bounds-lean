  apply congrArg₂ Tapes.mk
  · funext i; fin_cases i <;> rfl
  · funext i; fin_cases i
    · exact encoded_binary (hs 3)
    · exact encoded_binary (hs 4)
    · exact encoded_descriptor (RecursiveChildQuotientsConstant.bits (e-r))

