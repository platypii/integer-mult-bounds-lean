section Residues

variable (s t : ℕ)

/-- `u = t x mod s`. -/
def uu (x : ℕ) : ℕ := t * x % s

/-- The carry: `1` exactly when `2u ≥ s`. -/
def cc (x : ℕ) : ℕ := (2 * uu s t x + s) / (2 * s)

/-- The magnitude of the centered residue. -/
def bb (x : ℕ) : ℕ := uu s t x + s * cc s t x - 2 * (uu s t x * cc s t x)

theorem uu_lt (hs : 0 < s) (x : ℕ) : uu s t x < s := Nat.mod_lt _ hs

theorem cc_cases (hs : 0 < s) (x : ℕ) :
    (2 * uu s t x < s ∧ cc s t x = 0) ∨ (s ≤ 2 * uu s t x ∧ cc s t x = 1) := by
  have hu := uu_lt s t hs x
  unfold cc
  rcases Nat.lt_or_ge (2 * uu s t x) s with h | h
  · exact Or.inl ⟨h, Nat.div_eq_of_lt (by omega)⟩
  · exact Or.inr ⟨h, Nat.div_eq_of_lt_le (by omega) (by omega)⟩

theorem bb_hyp (x : ℕ) : 2 * (uu s t x * cc s t x) ≤ uu s t x + s * cc s t x := by
  rcases Nat.eq_zero_or_pos s with h0 | hs
  · subst h0; simp [uu, cc]
  rcases cc_cases s t hs x with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [h2] <;> have := uu_lt s t hs x <;> omega

theorem bb_le (hs : 0 < s) (x : ℕ) : 2 * bb s t x ≤ s := by
  have := uu_lt s t hs x
  unfold bb
  rcases cc_cases s t hs x with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [h2] <;> omega

theorem res_nat (x : ℕ) : TableIdx.res s t x = uu s t x := by
  unfold TableIdx.res uu
  rw [show (t : ℤ) * (x : ℤ) % (s : ℤ) = ((t * x % s : ℕ) : ℤ) by push_cast; rfl, Int.toNat_natCast]

theorem rr_nat (hs : 0 < s) (x : ℕ) : rr s t x = (uu s t x : ℤ) - s * cc s t x := by
  rw [TableIdx.rr_eq s t hs, res_nat]
  rcases cc_cases s t hs x with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [h2] <;> simp [h1, not_lt.mpr]

theorem rr_sq_bb (hs : 0 < s) (x : ℕ) : (rr s t x) ^ 2 = (bb s t x : ℤ) ^ 2 := by
  rw [rr_nat s t hs]
  have := uu_lt s t hs x
  unfold bb
  rcases cc_cases s t hs x with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [h2]
  · simp
  · rw [show uu s t x + s * 1 - 2 * (uu s t x * 1) = s - uu s t x by omega, Nat.cast_sub this.le]; push_cast; ring

theorem rr_period (hs : 0 < s) (x k : ℤ) : rr s t (x + s * k) = rr s t x := by
  unfold rr
  have : 2 * (t : ℤ) * (x + s * k) + s = (2 * t * x + s) + (t * k) * ((2 * s : ℕ) : ℤ) := by push_cast; ring
  rw [this, Int.add_mul_ediv_right _ _ (by positivity)]
  ring

theorem toNat_mul_sub (k X Y : ℕ) : ((k : ℤ) * ((X : ℤ) - Y)).toNat = k * (X - Y) := by
  rcases le_total Y X with h | h
  · rw [← Nat.cast_sub h, ← Nat.cast_mul, Int.toNat_natCast]
  · rw [Nat.sub_eq_zero_of_le h, mul_zero, Int.toNat_eq_zero]
    exact mul_nonpos_of_nonneg_of_nonpos (by positivity) (by omega)

end Residues

section Entries

variable (s t : ℕ)

/-- `|th + rr ℓ|` for `h = −d`. -/
def An (ℓ d : ℕ) : ℕ := t * d + s * cc s t ℓ - uu s t ℓ

/-- A natural representative of `ℓ − d` modulo `s`. -/
def Xn (ℓ d : ℕ) : ℕ := ℓ + s * d - d

/-- `|th + rr ℓ|` for `h = d`. -/
def Ap (ℓ d : ℕ) : ℕ := t * d + uu s t ℓ - s * cc s t ℓ

theorem an_hyp (hs : 0 < s) (hst : s ≤ t) (ℓ d : ℕ) (hd : 1 ≤ d) : uu s t ℓ ≤ t * d + s * cc s t ℓ := by
  have hT : t ≤ t * d := Nat.le_mul_of_pos_right t hd
  have := uu_lt s t hs ℓ
  generalize t * d = T at hT ⊢
  generalize s * cc s t ℓ = C
  omega

theorem ap_hyp (hs : 0 < s) (hst : s ≤ t) (ℓ d : ℕ) (hd : 1 ≤ d) : s * cc s t ℓ ≤ t * d + uu s t ℓ := by
  have hT : t ≤ t * d := Nat.le_mul_of_pos_right t hd
  rcases cc_cases s t hs ℓ with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [h2] <;>
    generalize t * d = T at hT ⊢ <;> omega

theorem xn_hyp (hs : 0 < s) (ℓ d : ℕ) : d ≤ ℓ + s * d := by
  have : d ≤ s * d := Nat.le_mul_of_pos_left d hs
  omega

theorem an_ge (hs : 0 < s) (hst : s ≤ t) (ℓ d x : ℕ) (hd : 1 ≤ d) : bb s t x ≤ An s t ℓ d := by
  have hb := bb_le s t hs x
  have hT : t ≤ t * d := Nat.le_mul_of_pos_right t hd
  have := uu_lt s t hs ℓ
  unfold An
  rcases cc_cases s t hs ℓ with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [h2] <;>
    generalize t * d = T at hT ⊢ <;> omega

theorem ap_ge (hs : 0 < s) (hst : s ≤ t) (ℓ d x : ℕ) (hd : 1 ≤ d) : bb s t x ≤ Ap s t ℓ d := by
  have hb := bb_le s t hs x
  have hT : t ≤ t * d := Nat.le_mul_of_pos_right t hd
  have := uu_lt s t hs ℓ
  unfold Ap
  rcases cc_cases s t hs ℓ with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [h2] <;>
    generalize t * d = T at hT ⊢ <;> omega

theorem tabE_neg (α p : ℕ) (hs : 0 < s) (hst : s ≤ t) (ℓ d : ℕ) (hℓ : ℓ < s) (hd : 1 ≤ d) :
    WeightNat.tableENat s t α p (ℓ : ZMod s) (-(d : ℤ)) =
      WeightNat.expPiNat true p (α ^ 2 * (An s t ℓ d ^ 2 - bb s t (Xn s ℓ d) ^ 2)) (s ^ 2) := by
  have : NeZero s := ⟨by omega⟩
  unfold WeightNat.tableENat
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt hℓ]
  have hu := an_hyp s t hs hst ℓ d hd
  have e1 : ((t : ℤ) * -(d : ℤ) + rr s t ℓ) ^ 2 = ((An s t ℓ d : ℕ) : ℤ) ^ 2 := by
    rw [rr_nat s t hs, An, Nat.cast_sub hu]; push_cast; ring
  have hx := xn_hyp s hs ℓ d
  have e2 : rr s t ((ℓ : ℤ) + -(d : ℤ)) = rr s t ((Xn s ℓ d : ℕ) : ℤ) := by
    rw [Xn, Nat.cast_sub hx, ← rr_period s t hs ((ℓ : ℤ) + -(d : ℤ)) d]; push_cast; ring_nf
  rw [e1, e2, rr_sq_bb s t hs, show ((α : ℤ)) ^ 2 = ((α ^ 2 : ℕ) : ℤ) by push_cast; rfl, ← Nat.cast_pow,
    ← Nat.cast_pow, toNat_mul_sub]

theorem tabE_pos (α p : ℕ) (hs : 0 < s) (hst : s ≤ t) (ℓ d : ℕ) (hℓ : ℓ < s) (hd : 1 ≤ d) :
    WeightNat.tableENat s t α p (ℓ : ZMod s) (d : ℤ) =
      WeightNat.expPiNat true p (α ^ 2 * (Ap s t ℓ d ^ 2 - bb s t (ℓ + d) ^ 2)) (s ^ 2) := by
  have : NeZero s := ⟨by omega⟩
  unfold WeightNat.tableENat
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt hℓ]
  have hu := ap_hyp s t hs hst ℓ d hd
  have e1 : ((t : ℤ) * (d : ℤ) + rr s t ℓ) ^ 2 = ((Ap s t ℓ d : ℕ) : ℤ) ^ 2 := by
    rw [rr_nat s t hs, Ap, Nat.cast_sub hu]; push_cast; ring
  have e2 : rr s t ((ℓ : ℤ) + (d : ℤ)) = rr s t ((ℓ + d : ℕ) : ℤ) := by push_cast; rfl
  rw [e1, e2, rr_sq_bb s t hs, show ((α : ℤ)) ^ 2 = ((α ^ 2 : ℕ) : ℤ) by push_cast; rfl, ← Nat.cast_pow,
    ← Nat.cast_pow, toNat_mul_sub]

/-- Entry `e = ℓ(2n+1) + j` of the off-diagonal table; zero at `j = n`. -/
def wE (α p n e : ℕ) : ℕ :=
  if e % (2 * n + 1) = n then 0
  else WeightNat.tableENat s t α p ((e / (2 * n + 1) : ℕ) : ZMod s) (-(n : ℤ) + (e % (2 * n + 1) : ℕ))

theorem wE_neg (α p n e : ℕ) (hs : 0 < s) (hst : s ≤ t) (he : e < s * (2 * n + 1)) (hj : e % (2 * n + 1) < n) :
    WeightNat.expPiNat true p (α ^ 2 * (An s t (e / (2 * n + 1)) (n - e % (2 * n + 1)) ^ 2 -
      bb s t (Xn s (e / (2 * n + 1)) (n - e % (2 * n + 1))) ^ 2)) (s ^ 2) = wE s t α p n e := by
  have hl : e / (2 * n + 1) < s := Nat.div_lt_of_lt_mul (by rwa [mul_comm])
  unfold wE
  simp only [show ¬ e % (2 * n + 1) = n by omega, ↓reduceIte]
  rw [show -(n : ℤ) + ((e % (2 * n + 1) : ℕ) : ℤ) = -((n - e % (2 * n + 1) : ℕ) : ℤ) by
    push_cast [Nat.cast_sub hj.le]; ring, tabE_neg s t α p hs hst _ _ hl (by omega)]

theorem wE_pos (α p n e : ℕ) (hs : 0 < s) (hst : s ≤ t) (he : e < s * (2 * n + 1)) (hj : n < e % (2 * n + 1)) :
    WeightNat.expPiNat true p (α ^ 2 * (Ap s t (e / (2 * n + 1)) (e % (2 * n + 1) - n) ^ 2 -
      bb s t (e / (2 * n + 1) + (e % (2 * n + 1) - n)) ^ 2)) (s ^ 2) = wE s t α p n e := by
  have hl : e / (2 * n + 1) < s := Nat.div_lt_of_lt_mul (by rwa [mul_comm])
  unfold wE
  simp only [show ¬ e % (2 * n + 1) = n by omega, ↓reduceIte]
  rw [show -(n : ℤ) + ((e % (2 * n + 1) : ℕ) : ℤ) = ((e % (2 * n + 1) - n : ℕ) : ℤ) by
    push_cast [Nat.cast_sub hj.le]; ring, tabE_pos s t α p hs hst _ _ hl (by omega)]

theorem wE_zero (α p n e : ℕ) (hj : e % (2 * n + 1) = n) : wE s t α p n e = 0 := by
  unfold wE; simp [hj]

end Entries

section Words

/-- The first `n` words of a table of naturals, each padded to width `w`. -/
def tabF (f : ℕ → ℕ) (w n : ℕ) : List (List Bool) := (List.range n).map fun e => padTo (f e) w

/-- The output tape contents after `n` entries. -/
def ytF (f : ℕ → ℕ) (w n : ℕ) : List (Fin (a + 4)) := flat (wordRecs (a := a) (tabF f w n))

theorem ytF_succ (f : ℕ → ℕ) (w e : ℕ) :
    ytF (a := a) f w (e + 1) = ytF (a := a) f w e ++ ((padTo (f e) w).map bitSymbol ++ [blank]) := by
  unfold ytF tabF
  rw [List.range_succ, List.map_append, wordRecs, List.map_append, flat_append, List.map_singleton,
    List.map_singleton, flat_singleton]
  rfl

theorem ytF_tape (f : ℕ → ℕ) (w e : ℕ) :
    putWord (putWord (fun _ => blank) 0 (ytF (a := a) f w e)) (↑(ytF (a := a) f w e).length : ℤ)
      ((padTo (f e) w).map bitSymbol) = putWord (fun _ => blank) 0 (ytF (a := a) f w (e + 1)) := by
  rw [ytF_succ, ← List.append_assoc, putWord_blank_snoc]
  have := putWord_append_forward (fun _ => (blank : Fin (a + 4))) 0 (ytF (a := a) f w e)
    ((padTo (f e) w).map bitSymbol)
  rw [zero_add] at this
  exact this

theorem ytF_len (f : ℕ → ℕ) (w e : ℕ) (h : (canon (f e)).length ≤ w) :
    (↑(ytF (a := a) f w e).length : ℤ) + ↑w + 1 = ↑(ytF (a := a) f w (e + 1)).length := by
  rw [ytF_succ]
  simp only [List.length_append, List.length_map, List.length_singleton, RegWord.padTo_length _ _ h]
  push_cast; ring

end Words

