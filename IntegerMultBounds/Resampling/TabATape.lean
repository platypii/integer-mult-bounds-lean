    (hcw : ∀ e, e < t * (2 * m + 1) → (canon (wA s t m α p e)).length ≤ w) :
    ∃ c, HoareTime (whileLoop (tBodyProg (a := a)) flagTest) (fun v => v = tabL s t m α p w 0)
      (fun v => v = tabL s t m α p w (t * (2 * m + 1))) c := by
  choose cost hcost using fun e (he : e < t * (2 * m + 1)) => tBody_hoare (a := a) s t m α p w e hp ht hα he (hcw e he)
  refine ⟨_, while_chain_hoare _ flagTest (tabL s t m α p w) (fun e => if he : e < t * (2 * m + 1) then cost e he else 0)
    (t * (2 * m + 1)) (fun i hi => by simpa [hi] using hcost i hi) (fun j hj => ?_) ?_⟩
  · simp only [tabL, flagTest, Tapes.reads, bank, Fin.isValue, Fin.reduceEq, ↓reduceIte, decide_eq_true_eq]
    simp [putWord, hj]
  · simp only [tabL, flagTest, Tapes.reads, bank, Fin.isValue, Fin.reduceEq, ↓reduceIte, decide_eq_false_iff_not]
    simp [putWord, bitSymbol]

def tableAProg := seq (seq (seq (seq (setupAProg (a := a)) (whileLoop (powBodyProg (a := a)) flagTest)) (setupBProg (a := a)))
  (whileLoop (tBodyProg (a := a)) flagTest)) (tDoneProg (a := a))

