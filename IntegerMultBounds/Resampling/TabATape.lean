/-! The Gaussian weight table `tableA` on tapes: from registers holding
`s, t, m, α, p` and a width ruler, compute `piN p`, `2^(5p)` and `2^(4p)`,
then for each entry `e = k(2m+1) + i` the natural exponent numerator
`(sk − t j)²` with `j = ⌊sk/t⌋ − m + i`, run the negative-exponent weight
routine, divide by `α`, and append the result as a `w`-bit word to the
output tape. Generated by `tabagen.py`. -/

namespace IntegerMultBounds.Resampling.TabATape

open IntegerMultBounds.Machine
open IntegerMultBounds.Machine.Registers (canon canon_value)
open IntegerMultBounds.Machine.OrderedSelect (flat flat_append flat_singleton putWord_blank_snoc)
open IntegerMultBounds.Machine.GaussianLine (wordRecs centre)
open IntegerMultBounds.Machine.FixedMul (ruler ruler_nonblank ruler_length)
open IntegerMultBounds.Machine.RegWord (padTo)
open IntegerMultBounds.Machine.CopyCells (cells)

variable {a : ℕ}

theorem reg0 : (putWord (fun _ => (blank : Fin (a + 4))) 0 ((canon 0).map bitSymbol)) = fun _ => blank := rfl

section Values

/-- The natural exponent numerator of entry `e`: `|s k − t j|`. -/
def xv (s t m e : ℕ) : ℕ :=
  if e % (2 * m + 1) ≤ m then s * (e / (2 * m + 1)) % t + t * (m - e % (2 * m + 1))
  else t * (e % (2 * m + 1) - m) - s * (e / (2 * m + 1)) % t

/-- Entry `e = k (2m+1) + i` of the table: the weight at `k`, `j = ⌊sk/t⌋ − m + i`. -/
def wA (s t m α p e : ℕ) : ℕ :=
  WeightNat.tableANat s t α p ((e / (2 * m + 1) : ℕ) : ZMod t)
    ((centre s t (e / (2 * m + 1)) : ℤ) - m + (e % (2 * m + 1) : ℕ))

theorem wA_eq (s t m α p e : ℕ) (ht : 0 < t) (he : e < t * (2 * m + 1)) :
    WeightNat.expPiNat true p (xv s t m e ^ 2) (α ^ 2 * t ^ 2) / α = wA s t m α p e := by
  have hk : e / (2 * m + 1) < t := Nat.div_lt_of_lt_mul (by rwa [mul_comm])
  have hz : (((e / (2 * m + 1) : ℕ) : ZMod t)).val = e / (2 * m + 1) := by
    have : NeZero t := ⟨by omega⟩
    rw [ZMod.val_natCast, Nat.mod_eq_of_lt hk]
  unfold wA WeightNat.tableANat
  rw [hz]
  simp only [centre]
  rw [TableIdx.gauss_num s t m _ _ ht, xv]
  split_ifs <;> rfl

theorem xhyp (s t m e : ℕ) (ht : 0 < t) (hi : m < e % (2 * m + 1)) :
    s * (e / (2 * m + 1)) % t ≤ t * (e % (2 * m + 1) - m) := by
  have h1 := Nat.mod_lt (s * (e / (2 * m + 1))) ht
  have h2 : t * 1 ≤ t * (e % (2 * m + 1) - m) := Nat.mul_le_mul_left _ (by omega)
  omega

/-- The first `n` table words. -/
def tabA (s t m α p w n : ℕ) : List (List Bool) := (List.range n).map fun e => padTo (wA s t m α p e) w

/-- The output tape contents after `n` entries. -/
def ytA (s t m α p w n : ℕ) : List (Fin (a + 4)) := flat (wordRecs (a := a) (tabA s t m α p w n))

theorem cells_R (n w : ℕ) (h : (canon n).length ≤ w) :
    cells (putWord (fun _ => (blank : Fin (a + 4))) 0 ((canon n).map bitSymbol)) 0 w = (padTo n w).map bitSymbol :=
  RegWord.cells_reg n w h

theorem ytA_succ (s t m α p w e : ℕ) :
    ytA (a := a) s t m α p w (e + 1) = ytA (a := a) s t m α p w e ++ ((padTo (wA s t m α p e) w).map bitSymbol ++ [blank]) := by
  unfold ytA tabA
  rw [List.range_succ, List.map_append, wordRecs, List.map_append, flat_append, List.map_singleton,
    List.map_singleton, flat_singleton]
  rfl

theorem ytA_tape (s t m α p w e : ℕ) :
    putWord (putWord (fun _ => blank) 0 (ytA (a := a) s t m α p w e)) (↑(ytA (a := a) s t m α p w e).length : ℤ)
      ((padTo (wA s t m α p e) w).map bitSymbol) = putWord (fun _ => blank) 0 (ytA (a := a) s t m α p w (e + 1)) := by
  rw [ytA_succ, ← List.append_assoc, putWord_blank_snoc]
  have := putWord_append_forward (fun _ => (blank : Fin (a + 4))) 0 (ytA (a := a) s t m α p w e)
    ((padTo (wA s t m α p e) w).map bitSymbol)
  rw [zero_add] at this
  exact this

theorem ytA_len (s t m α p w e : ℕ) (h : (canon (wA s t m α p e)).length ≤ w) :
    (↑(ytA (a := a) s t m α p w e).length : ℤ) + ↑w + 1 = ↑(ytA (a := a) s t m α p w (e + 1)).length := by
  rw [ytA_succ]
  simp only [List.length_append, List.length_map, List.length_singleton, RegWord.padTo_length _ _ h]
  push_cast; ring

theorem pw_zero (s t m α p w : ℕ) : putWord (fun _ => blank) 0 (ytA (a := a) s t m α p w 0) = fun _ => blank := rfl

