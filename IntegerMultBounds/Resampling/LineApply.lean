/-- All `L` lines: the output tape ends holding `outs wt arr s t m p w W L`. -/
theorem loop_hoare (wt arr : List (List Bool)) (s t m p w W L : ℕ) (sW tW : List Bool) (pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRl pRx1 pRx2 pRk : ℤ) (hw : 1 ≤ w) (hpw : p ≤ w) (hwW : w ≤ W) (hwt : ∀ x ∈ wt, x.length = w) (hwtl : wt.length = t * (2 * m + 1)) (harr : arr.length = 2 * s * L) (harrw : ∀ x ∈ arr, x.length = w) (hms : m + 1 ≤ s) (hst : s ≤ t) (hs : 0 < s) (hsv : Counter.value sW = s) (htv : Counter.value tW = t) (hsl : sW.length ≤ tW.length + 1) :
    ∃ c, HoareTime (program (a := a)) (fun v => v = Z wt arr s t m p w W L sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRl pRx1 pRx2 pRk hw hpw hwW hwt hwtl harr harrw hms hst hs hsv htv hsl 0) (fun v => v = Z wt arr s t m p w W L sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRl pRx1 pRx2 pRk hw hpw hwW hwt hwtl harr harrw hms hst hs hsv htv hsl L) c := by
  choose cost hcost using fun ℓ (hℓ : ℓ < L) => step_hoare (a := a) wt arr s t m p w W L sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRl pRx1 pRx2 pRk hw hpw hwW hwt hwtl harr harrw hms hst hs hsv htv hsl ℓ hℓ
  refine ⟨_, while_chain_hoare (step (a := a)) (fun sy => decide (sy 28 ≠ blank)) (fun ℓ => Z wt arr s t m p w W L sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRl pRx1 pRx2 pRk hw hpw hwW hwt hwtl harr harrw hms hst hs hsv htv hsl ℓ)
    (fun ℓ => if hℓ : ℓ < L then cost ℓ hℓ else 0) L (fun ℓ hℓ => by simp only [hℓ, ↓reduceDIte]; exact hcost ℓ hℓ) (fun K hK => ?_) ?_⟩
  · simp only [Z, Tapes.reads, bank, Fin.isValue, Fin.reduceEq, ↓reduceIte, decide_eq_true_eq, ne_eq]
