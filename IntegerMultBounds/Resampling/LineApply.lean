import IntegerMultBounds.Machine.NeumannLoop

/-! The Gaussian window sums applied line by line: an array tape holds `L`
lines of `2s` words (complex entries, real and imaginary words), and for each
line the machine copies it out, builds its cyclic extension, runs the line
machine with `t` windows, and appends the `2t` accumulator words to the
output tape. The output is exactly the concatenation of
`outWords wt (ext s m line) s t m p w W t` over the lines, so each line's
words are the `Ã` numerators of that line (`TableValue.a_tables`). This is the
innermost-axis step of the linewise application of Lemma 7.2. Generated by
`lalgen.py`. -/

namespace IntegerMultBounds.Machine.LineApply

open OrderedSelect (inTape start flat flat_append)
open GaussianLine (wordRecs wordRecs_length outWords)
open Resampling.NeumannWords (ext ext_mem)
open FixedMul (ruler ruler_nonblank ruler_length)
open NeumannStep (wordRecs_ne skipN_hoare copyN_hoare copyAll_hoare skipAll_hoare start_zero start_zero_add
  pw_nil inTape_def start_le flat_wordRecs_length ext_flat outWords_width)

variable {a : ℕ}

/-- Line `ℓ` of the array: words `2sℓ, …, 2sℓ + 2s − 1`. -/
def line (arr : List (List Bool)) (s ℓ : ℕ) : List (List Bool) := (arr.drop (2 * s * ℓ)).take (2 * s)

/-- The output words of the first `ℓ` lines. -/
def outs (wt arr : List (List Bool)) (s t m p w W : ℕ) : ℕ → List (List Bool)
  | 0 => []
  | ℓ + 1 => outs wt arr s t m p w W ℓ ++ outWords wt (ext s m (line arr s ℓ)) s t m p w W t

theorem line_length (arr : List (List Bool)) (s ℓ : ℕ) (h : 2 * s * (ℓ + 1) ≤ arr.length) :
    (line arr s ℓ).length = 2 * s := by
  simp only [line, List.length_take, List.length_drop]; rw [Nat.mul_succ] at h; omega

theorem line_mem (arr : List (List Bool)) (s ℓ : ℕ) : ∀ x ∈ line arr s ℓ, x ∈ arr :=
  fun _ hx => List.mem_of_mem_drop (List.mem_of_mem_take hx)

theorem recs_line (arr : List (List Bool)) (s ℓ : ℕ) :
    ((wordRecs (a := a) arr).drop (2 * s * ℓ)).take (2 * s) = wordRecs (a := a) (line arr s ℓ) := by
  simp [wordRecs, line, List.map_drop, List.map_take]

theorem y_line (arr : List (List Bool)) (s ℓ : ℕ) :
    putWord (fun _ => blank) 0 (flat (((wordRecs (a := a) arr).drop (2 * s * ℓ)).take (2 * s))) =
      inTape (wordRecs (a := a) (line arr s ℓ)) := by rw [recs_line]; rfl

theorem y_line_len (arr : List (List Bool)) (s ℓ : ℕ) :
    ((flat (((wordRecs (a := a) arr).drop (2 * s * ℓ)).take (2 * s))).length : ℤ) =
      ((flat (wordRecs (a := a) (line arr s ℓ))).length : ℤ) := by rw [recs_line]

theorem start_next_line (arr : List (List Bool)) (s ℓ : ℕ) :
    start (wordRecs (a := a) arr) (2 * s * ℓ + 2 * s) = start (wordRecs (a := a) arr) (2 * s * (ℓ + 1)) := by
  rw [Nat.mul_succ]

theorem outs_tape (wt arr : List (List Bool)) (s t m p w W ℓ : ℕ) :
    putWord (fun _ => blank) 0 (flat (wordRecs (a := a) (outs wt arr s t m p w W ℓ)) ++
      flat (wordRecs (a := a) (outWords wt (ext s m (line arr s ℓ)) s t m p w W t))) =
      putWord (fun _ => blank) 0 (flat (wordRecs (a := a) (outs wt arr s t m p w W (ℓ + 1)))) := by
  rw [outs, wordRecs, wordRecs, wordRecs, List.map_append, flat_append]

theorem outs_len (wt arr : List (List Bool)) (s t m p w W ℓ : ℕ) :
    ((flat (wordRecs (a := a) (outs wt arr s t m p w W ℓ)) ++
      flat (wordRecs (a := a) (outWords wt (ext s m (line arr s ℓ)) s t m p w W t))).length : ℤ) =
      ((flat (wordRecs (a := a) (outs wt arr s t m p w W (ℓ + 1)))).length : ℤ) := by
  rw [outs, wordRecs, wordRecs, wordRecs, List.map_append, flat_append]

/-- The line machine with `t` windows, in clean bank form. -/
theorem gaussA_run (wt us : List (List Bool)) (s t m p w W : ℕ) (sW tW : List Bool)
    (pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc : ℤ)
    (hw : 1 ≤ w) (hpw : p ≤ w) (hwW : w ≤ W) (hwt : ∀ x ∈ wt, x.length = w)
    (hu : ∀ x ∈ us, x.length = w) (hwtl : wt.length = t * (2 * m + 1))
    (hul : 2 * (s + 2 * m + 1) ≤ us.length) (hst : s ≤ t) (hs : 0 < s)
    (hsv : Counter.value sW = s) (htv : Counter.value tW = t) (hsl : sW.length ≤ tW.length + 1) :
    HoareTime (GaussianLine.program (a := a))
      (fun v => v = GaussianLine.bank (inTape (wordRecs (a := a) wt)) (inTape (wordRecs (a := a) us)) (fun _ => blank) (fun _ => blank) (fun _ => blank) (fun _ => blank) (fun _ => blank) (fun _ => blank) (putWord (fun _ => blank) pRp (ruler p)) (putWord (fun _ => blank) pRw (ruler w)) (putWord (fun _ => blank) pR2 (ruler (2 * w))) (fun _ => blank) (fun _ => blank) (putWord (fun _ => blank) pA1 ((List.replicate W false).map bitSymbol)) (putWord (fun _ => blank) pA2 ((List.replicate W false).map bitSymbol)) (fun _ => blank) (putWord (fun _ => blank) pRm (ruler (2 * m + 1))) (putWord (fun _ => blank) pRW (ruler W)) (fun _ => blank) (putWord (fun _ => blank) pCs (sW.map bitSymbol)) (putWord (fun _ => blank) pCt (tW.map bitSymbol)) (fun _ => blank) 0 0 pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 0 pRm pRW pCr pCs pCt pFc)
      (fun v => v = GaussianLine.bank (inTape (wordRecs (a := a) wt)) (inTape (wordRecs (a := a) us)) (fun _ => blank) (fun _ => blank) (fun _ => blank) (fun _ => blank) (fun _ => blank) (fun _ => blank) (putWord (fun _ => blank) pRp (ruler p)) (putWord (fun _ => blank) pRw (ruler w)) (putWord (fun _ => blank) pR2 (ruler (2 * w))) (fun _ => blank) (fun _ => blank) (putWord (fun _ => blank) pA1 ((List.replicate W false).map bitSymbol)) (putWord (fun _ => blank) pA2 ((List.replicate W false).map bitSymbol)) (putWord (fun _ => blank) 0 (flat (wordRecs (a := a) (outWords wt us s t m p w W t)))) (putWord (fun _ => blank) pRm (ruler (2 * m + 1))) (putWord (fun _ => blank) pRW (ruler W)) (putWord (fun _ => blank) pCr ((OrderedSelect.rWord sW tW [] t).map bitSymbol)) (putWord (fun _ => blank) pCs (sW.map bitSymbol)) (putWord (fun _ => blank) pCt (tW.map bitSymbol)) (fun _ => blank) (↑(flat (wordRecs (a := a) wt)).length) (↑(start (wordRecs (a := a) us) (2 * s))) pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 (↑(flat (wordRecs (a := a) (outWords wt us s t m p w W t))).length) pRm pRW pCr pCs pCt pFc)
      (t * (GaussianLine.outerBound p w W m tW.length + 2)) := by
  have h := GaussianLine.line_hoare (a := a) wt us s t m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2
    pA1 pA2 0 pRm pRW pCr pCs pCt pFc hw hpw hwW hwt hu hwtl hul hst hs hsv htv hsl
  refine h.consequence (fun v hv => ?_) (fun v hv => ?_) le_rfl
  · rw [hv]
    simp only [GaussianLine.Y, zero_mul, add_zero, mul_zero, GaussianLine.centre, Nat.zero_div,
      Nat.cast_zero, GaussianLine.accR_zero, GaussianLine.accI_zero]
    rfl
  · rw [hv]
    have hc : GaussianLine.centre s t t = s := by
      unfold GaussianLine.centre; exact Nat.mul_div_cancel _ (by omega)
    have hl : t * (2 * m + 1) = (wordRecs (a := a) wt).length := by rw [wordRecs_length, hwtl]
    simp only [GaussianLine.Y, add_zero, mul_zero, hc, Nat.cast_zero, zero_add, GaussianLine.accR_zero,
      GaussianLine.accI_zero, hl, OrderedSelect.start_length]

