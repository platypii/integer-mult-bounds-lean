/-- The `w`-bit two's complement code of `−v`. -/
def negv (w v : ℕ) : ℕ := (2 ^ w - v) % 2 ^ w

theorem negv_lt (w v : ℕ) : negv w v < 2 ^ w := Nat.mod_lt _ (by positivity)

theorem canon_negv (w v : ℕ) : (canon (negv w v)).length ≤ w := by
  have := RegWord.canon_length_lt (negv w v) (w + 1) (by omega) (by simpa using negv_lt w v)
  omega

theorem signed_negv (w v : ℕ) (hw : 1 ≤ w) (hv : v ≤ 2 ^ (w - 1)) : signed (padTo (negv w v) w) = -(v : ℤ) := by
  have hlen := RegWord.padTo_length _ _ (canon_negv w v)
  have hne : padTo (negv w v) w ≠ [] := by intro h; rw [h] at hlen; simp at hlen; omega
  have hpow : (2 : ℤ) ^ w = 2 * 2 ^ (w - 1) := by rw [← pow_succ']; congr 1; omega
  have hvw : v ≤ 2 ^ w := hv.trans (Nat.pow_le_pow_right two_pos (by omega))
  have h1 : signed (padTo (negv w v) w) % 2 ^ w = (-(v : ℤ)) % 2 ^ w := by
    have := TwosComplement.signed_emod (padTo (negv w v) w)
    rw [hlen, RegWord.value_padTo] at this
    rw [this, negv]
    push_cast [Nat.cast_sub hvw]
    rw [show (2 : ℤ) ^ w - v = -v + 1 * 2 ^ w by ring, Int.add_mul_emod_self_right]
  obtain ⟨hb1, hb2⟩ := TwosComplement.signed_bounds _ hne
  rw [hlen] at hb1 hb2
  have hd : (2 : ℤ) ^ w ∣ signed (padTo (negv w v) w) - -(v : ℤ) := Int.ModEq.dvd h1.symm
  have habs : |signed (padTo (negv w v) w) - -(v : ℤ)| < 2 ^ w := by
    have : (v : ℤ) ≤ 2 ^ (w - 1) := by exact_mod_cast hv
    rw [abs_lt]; constructor <;> linarith
  have := Int.eq_zero_of_abs_lt_dvd hd habs
  linarith

theorem tabD (s t α p ℓ : ℕ) (hs : 0 < s) (hℓ : ℓ < s) :
    WeightNat.tableDNat s t α p (ℓ : ZMod s) =
      WeightNat.expPiNat false p (α ^ 2 * bb s t ℓ ^ 2) (s ^ 2) / 2 ^ (2 * α ^ 2) := by
  have : NeZero s := ⟨by omega⟩
  unfold WeightNat.tableDNat
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt hℓ, rr_sq_bb s t hs]
  congr 2

/-- Entry `ℓ` of the negated diagonal table. -/
def dW (s t α p w ℓ : ℕ) : ℕ := negv w (WeightNat.tableDNat s t α p (ℓ : ZMod s))

/-- The constant halving entry. -/
def hW (w p : ℕ) : ℕ → ℕ := fun _ => negv w (2 ^ (p - 1))

theorem ytF_tape_h (w p e : ℕ) :
    putWord (putWord (fun _ => blank) 0 (ytF (a := a) (hW w p) w e)) (↑(ytF (a := a) (hW w p) w e).length : ℤ)
      ((padTo (negv w (2 ^ (p - 1))) w).map bitSymbol) = putWord (fun _ => blank) 0 (ytF (a := a) (hW w p) w (e + 1)) :=
  ytF_tape (hW w p) w e

