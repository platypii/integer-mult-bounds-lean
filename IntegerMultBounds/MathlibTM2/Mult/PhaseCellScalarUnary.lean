module

public import IntegerMultBounds.MathlibTM2.Mult.PhaseCellScalarPlacement
public import IntegerMultBounds.MathlibTM2.Host.BinArith

/-! # Produce binary scalar-setup dimensions from retained unary headers

Ports 20--25 are reused only during setup, before the multiplier's private
workspace is needed. The source precision/width headers are restored exactly.
-/

@[expose] public section

namespace IntegerMultBounds.MathlibTM2.Mult.PhaseCellToeplitz.ScalarPlacement

open IntegerMultBounds IntegerMultBounds.Machine IntegerMultBounds.MathlibTM2
  IntegerMultBounds.MathlibTM2.Stack IntegerMultBounds.MathlibTM2.Host
  IntegerMultBounds.MathlibTM2.Node

variable {Q A : ℕ} {U P : Type} {body : P → Pr P 117 Q A U}

def unarySetup : Pr P 117 Q A U :=
  .seq (ucopy 94 23 24)
    (.seq (toBinary 100 23 20 24 25 20) (toBinary 94 23 21 24 25 21))

def unarySetupR (q w : ℕ) (R : Regs 117 A) : Regs 117 A :=
  Function.update (Function.update (Function.update R 23 (List.replicate w tick))
    20 (binSyms w q)) 21 (binSyms w w)

/-- No binary dimension word is supplied: both are generated by counted conversion. -/
theorem unarySetup_exec (q w : ℕ) (v : HS 117 Q A U) (S : Stacks 117 A)
    (hq : (S.R 100).length = q) (hw : (S.R 94).length = w)
    (hclean : ∀ k ∈ [(20 : Fin 117), 21, 23, 24, 25], S.R k = []) :
    ∃ v' m, v'.user = v.user ∧ m ≤ (q + w) * (4 * w + 10) + 12 * w + 20 ∧
      Exec body unarySetup (mk v S) m (mk v' { S with R := unarySetupR q w S.R }) := by
  obtain ⟨v₁, hu₁, he₁⟩ := ucopy_exec body
    (show (94 : Fin 117) ≠ 23 by decide) (show (94 : Fin 117) ≠ 24 by decide)
    (show (23 : Fin 117) ≠ 24 by decide) v S (hclean _ (by simp))
  let S₁ : Stacks 117 A := { S with R := Function.update S.R 23 (List.replicate w tick) }
  have he₁' : Exec body (ucopy 94 23 24) (mk v S) (4 * w + 4) (mk v₁ S₁) := by
    simpa only [hw, hclean 23 (by simp), List.append_nil] using he₁
  obtain ⟨v₂, m₂, hu₂, hm₂, he₂⟩ := toBinary_exec (body := body)
    (u := 100) (wR := 23) (c := 20) (t := 24) (tmp := 25) (by decide) 20 v₁ S₁
    (by simp [S₁, hclean _ (by simp : (20 : Fin 117) ∈ [20, 21, 23, 24, 25])])
    (by simp [S₁, hclean _ (by simp : (24 : Fin 117) ∈ [20, 21, 23, 24, 25])])
    (by simp [S₁, hclean _ (by simp : (25 : Fin 117) ∈ [20, 21, 23, 24, 25])])
  let S₂ : Stacks 117 A := { S₁ with R := Function.update S₁.R 20 (binSyms w q) }
  have he₂' : Exec body (toBinary 100 23 20 24 25 20) (mk v₁ S₁) m₂ (mk v₂ S₂) := by
    simpa only [S₁, Function.update_self, List.length_replicate,
      Function.update_of_ne (show (100 : Fin 117) ≠ 23 by decide), hq] using he₂
  obtain ⟨v₃, m₃, hu₃, hm₃, he₃⟩ := toBinary_exec (body := body)
    (u := 94) (wR := 23) (c := 21) (t := 24) (tmp := 25) (by decide) 21 v₂ S₂
    (by simp [S₂, S₁, hclean _ (by simp : (21 : Fin 117) ∈ [20, 21, 23, 24, 25])])
    (by simp [S₂, S₁, hclean _ (by simp : (24 : Fin 117) ∈ [20, 21, 23, 24, 25])])
    (by simp [S₂, S₁, hclean _ (by simp : (25 : Fin 117) ∈ [20, 21, 23, 24, 25])])
  have he₃' : Exec body (toBinary 94 23 21 24 25 21) (mk v₂ S₂) m₃
      (mk v₃ { S with R := unarySetupR q w S.R }) := by
    simpa only [S₂, S₁, Function.update_self, List.length_replicate,
      Function.update_of_ne (show (94 : Fin 117) ≠ 20 by decide),
      Function.update_of_ne (show (94 : Fin 117) ≠ 23 by decide), hw,
      Function.update_of_ne (show (23 : Fin 117) ≠ 20 by decide), unarySetupR] using he₃
  refine ⟨v₃, (4 * w + 4) + (m₂ + m₃), hu₃.trans (hu₂.trans hu₁), ?_, Exec.seq he₁' (Exec.seq he₂' he₃')⟩
  · simp only [S₁, Function.update_self, List.length_replicate,
      Function.update_of_ne (show (100 : Fin 117) ≠ 23 by decide), hq] at hm₂
    simp only [S₂, S₁, Function.update_of_ne (show (94 : Fin 117) ≠ 20 by decide),
      Function.update_of_ne (show (94 : Fin 117) ≠ 23 by decide), hw,
      Function.update_of_ne (show (23 : Fin 117) ≠ 20 by decide), Function.update_self,
      List.length_replicate] at hm₃
    nlinarith only [hm₂, hm₃]

/-- The existing table multiplier setup has room at binary width w≥5. -/
theorem table_room (w : ℕ) (hw : 5 ≤ w) : 4 * w + 2 < 2 ^ w := by
  induction w, hw using Nat.le_induction with
  | base => norm_num
  | succ w hw ih =>
      rw [pow_succ]
      omega

/-- At the selected scalar width, both generated dimensions fit and the doubling
program's temporary values fit. No independently supplied capacity is needed. -/
theorem unarySetup_room_of_width {q w : ℕ} (hw5 : 5 ≤ w) (hw : q + 4 ≤ w) :
    q < 2 ^ w ∧ w < 2 ^ w ∧ 4 * w + 2 < 2 ^ w := by
  have hh := table_room w hw5
  omega

theorem unarySetup_room {q w : ℕ} (hq : 1 ≤ q) (hw : q + 4 ≤ w) :
    q < 2 ^ w ∧ w < 2 ^ w ∧ 4 * w + 2 < 2 ^ w :=
  unarySetup_room_of_width (by omega) hw

end IntegerMultBounds.MathlibTM2.Mult.PhaseCellToeplitz.ScalarPlacement
