module

public import IntegerMultBounds.MathlibTM2.Mult.PhaseCellCorePublicationSchedule
public import IntegerMultBounds.MathlibTM2.Mult.ShortConvSetupOps

/-! Generate full-core controls by copying a count as delimiters. The one
clipped-core gap is generated by multiplying borrowed unary dimensions. -/
@[expose] public section
namespace IntegerMultBounds.MathlibTM2.Mult.PhaseCellToeplitz
open IntegerMultBounds IntegerMultBounds.MathlibTM2 IntegerMultBounds.MathlibTM2.Stack
  IntegerMultBounds.MathlibTM2.Host IntegerMultBounds.MathlibTM2.Fast IntegerMultBounds.MathlibTM2.Node
  IntegerMultBounds.MathlibTM2.Mult.ShortConv
variable {T Q A : ℕ} {P U : Type} {body : P → Pr P T Q A U}

theorem gatherControls_replicate_zero (A N : ℕ) :
    gatherControls A (List.replicate N 0) = List.replicate N blank := by
  induction N with
  | zero => rfl
  | succ N ih => simp [List.replicate_succ,gatherControls,ih]

theorem fullCorePublicationControls_exec (count control tmp : Fin T)
    (hreg : [count,control,tmp].Nodup) (s width w : ℕ) (hw : 0 < width)
    (v : HS T Q A U) (S : Stacks T A)
    (hcount : (S.R count).length = s/width) (htmp : S.R tmp = []) :
    ∃ v', v'.user = v.user ∧
      Exec body (copyR count control tmp (fun _ => blank)) (mk v S) (4*(s/width)+4)
        (mk v' {S with R := (Function.update S.R control
          (gatherControls A ((corePublicationWindows s width width hw).gaps w)++S.R control))}) := by
  have hr := hreg
  regs_ne hr
  obtain ⟨v',hu,he⟩ := copyR_exec (body := body) count control tmp ‹count ≠ control› ‹count ≠ tmp› ‹control ≠ tmp›
    (fun _ => blank) v S htmp
  refine ⟨v',hu,?_⟩
  simpa only [hcount,corePublication_full_gaps s width w hw,gatherControls_replicate_zero,
    List.map_const',List.reverse_replicate] using he

def clippedCorePublicationControls (count coreWidth wordWidth product control saved tmp : Fin T) : Pr P T Q A U :=
  .seq (unaryProduct count coreWidth product saved tmp)
    (.seq (.act (.push (.rt control) (fun _ => blank) .done))
      (.seq (unaryProduct product wordWidth control saved tmp) (uclear product)))

theorem clippedCorePublicationControls_exec (count coreWidth wordWidth product control saved tmp : Fin T)
    (hreg : [count,coreWidth,wordWidth,product,control,saved,tmp].Nodup)
    (s width w : ℕ) (hw : 0 < width) (hr : 0 < s%width)
    (v : HS T Q A U) (S : Stacks T A)
    (hcount : (S.R count).length = s/width) (hcore : (S.R coreWidth).length = width)
    (hword : (S.R wordWidth).length = w)
    (hproduct : S.R product = []) (hsaved : S.R saved = []) (htmp : S.R tmp = []) :
    ∃ v' n, v'.user = v.user ∧
      n ≤ (s/width)*(4*width+9)+(s/width*width)*(4*w+11)+11 ∧
      Exec body (clippedCorePublicationControls count coreWidth wordWidth product control saved tmp) (mk v S) n
        (mk v' {S with R := (Function.update S.R control
          (gatherControls A ((corePublicationWindows s width (s%width) hw).gaps w)++S.R control))}) := by
  have hregs := hreg
  regs_ne hregs
  obtain ⟨v₁,n₁,hu₁,hn₁,he₁⟩ := unaryProduct_exec (body := body)
    (show [count,coreWidth,product,saved,tmp].Nodup by regs_nodup) v S hsaved htmp
  let S₁ : Stacks T A := {S with R := Function.update S.R product (List.replicate (s/width*width) tick)}
  have he₁' : Exec body (unaryProduct count coreWidth product saved tmp) (mk v S) n₁ (mk v₁ S₁) := by
    simpa only [hcount,hcore,hproduct,List.append_nil] using he₁
  let S₂ : Stacks T A := {S₁ with R := Function.update S₁.R control (blank::S₁.R control)}
  have hp : Exec body (.act (.push (.rt control) (fun _ => blank) .done)) (mk v₁ S₁) 1 (mk v₁ S₂) := by
    simpa [S₂,Action.run,update_rt] using Exec.act (body := body) (.push (.rt control) (fun _ => blank) .done) (mk v₁ S₁)
  obtain ⟨v₂,n₂,hu₂,hn₂,he₂⟩ := unaryProduct_exec (body := body)
    (show [product,wordWidth,control,saved,tmp].Nodup by regs_nodup) v₁ S₂
    (by simp [S₂,S₁,‹control ≠ saved›.symm,‹product ≠ saved›.symm,hsaved])
    (by simp [S₂,S₁,‹control ≠ tmp›.symm,‹product ≠ tmp›.symm,htmp])
  let S₃ : Stacks T A := {S₂ with R := (Function.update S₂.R control
    (List.replicate (s/width*width*w) tick++S₂.R control))}
  have hpLen : (S₂.R product).length = s/width*width := by simp [S₂,S₁,‹product ≠ control›]
  have hwLen : (S₂.R wordWidth).length = w := by
    simp [S₂,S₁,‹wordWidth ≠ control›,‹wordWidth ≠ product›,hword]
  have he₂' : Exec body (unaryProduct product wordWidth control saved tmp) (mk v₁ S₂) n₂ (mk v₂ S₃) := by
    simpa only [hpLen,hwLen] using he₂
  obtain ⟨v₃,hu₃,he₃⟩ := uclear_exec (body := body) product v₂ S₃
  have hplen : (S₃.R product).length = s/width*width := by simp [S₃,‹product ≠ control›,hpLen]
  refine ⟨v₃,n₁+(1+(n₂+(2*(s/width*width)+2))),hu₃.trans hu₂ |>.trans hu₁,?_,?_⟩
  · simp only [hcount,hcore] at hn₁
    rw [hpLen,hwLen] at hn₂
    nlinarith only [hn₁,hn₂]
  · have hf : Function.update S₃.R product [] = Function.update S.R control
        (gatherControls A ((corePublicationWindows s width (s%width) hw).gaps w)++S.R control) := by
      funext i
      by_cases hip : i = product
      · subst i
        simp [‹product ≠ control›,hproduct]
      · by_cases hic : i = control
        · subst i
          simp [S₃,S₂,S₁,‹product ≠ control›.symm,
            corePublication_remainder_gaps s width w hw,hr,gatherControls]
        · simp [S₃,S₂,S₁,hip,hic]
    have hex := Exec.seq he₁' (Exec.seq hp (Exec.seq he₂' he₃))
    simpa only [clippedCorePublicationControls,hplen,hf] using hex

end IntegerMultBounds.MathlibTM2.Mult.PhaseCellToeplitz
