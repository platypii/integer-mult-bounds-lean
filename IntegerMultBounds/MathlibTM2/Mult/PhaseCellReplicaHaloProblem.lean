structure ReplicaHaloProblem (s : ℕ) where
  p : ℕ
  l : ℕ
  t : ℕ
  u : ℕ
  target : ℕ
  rhsExp : ℕ
  origin : ℕ
  span : ℕ
  α : ℝ
  d : ℝ
  Fs : List (ZMod s → GaussianInt)
  x : ℕ → ZMod s → ℝ
  p_pos : 0 < p
  s_lt_t : s < t
  band_fit : PhaseCellBand.width p u ≤ s
  u_pos : 1 ≤ u
  alpha_sq : α^2 = (u : ℝ)
  theta_pos : 0 < (t : ℝ)/s-1
  gap : (1 : ℝ)/4 ≤ d*((t : ℝ)/s-1)
  budget : α^2*d ≤ p
  span_fit : origin+span ≤ s
  rhs_bound : ∀ r < Fs.length, ∀ k,
    ‖value (executionPrecision p l target rhsExp) (Fs.reverse.getD r (fun _ => 0) k)‖ ≤ (2 : ℝ)^rhsExp
  solves : ∀ r < Fs.length, SchurDominance.Solves (realMatrix s t p u)
    (haloInterior s t (PhaseCellBand.width p u) origin (origin+span)) (x r)
    (fun k => (value (executionPrecision p l target rhsExp) (Fs.reverse.getD r (fun _ => 0) k)).re)

namespace ReplicaHaloProblem
variable {s T A : ℕ}

def precision (H : ReplicaHaloProblem s) := executionPrecision H.p H.l H.target H.rhsExp
def wordWidth (H : ReplicaHaloProblem s) := executionWidth H.p H.l H.target H.rhsExp
def stage (H : ReplicaHaloProblem s) := executionStagePrecision H.p H.l H.target H.rhsExp
def band (H : ReplicaHaloProblem s) := PhaseCellBand.width H.p H.u
def metadataWidth (H : ReplicaHaloProblem s) := weightWorkspaceWidth (2^15*H.p) H.precision H.wordWidth H.t H.u
def offsets (H : ReplicaHaloProblem s) (L : ℕ) := haloPackedOffsets s H.t H.band H.origin (H.origin+H.span) L
def originAt (H : ReplicaHaloProblem s) (L j : ℕ) : ZMod s := haloReplicaClassOrigin H.t H.band H.origin H.span L j
def windows (H : ReplicaHaloProblem s) (L : ℕ) (hL : 0 < L) := haloSpanPublicationWindows s H.t H.band H.origin H.span L hL

theorem metadataWidth_fits (H : ReplicaHaloProblem s) :
    H.wordWidth < 2^H.metadataWidth ∧ H.span < 2^H.metadataWidth ∧
      H.span*H.wordWidth < 2^H.metadataWidth := by
  obtain ⟨hw,hvolume⟩ := weightWorkspaceWidth_symbolVolume (2^15*H.p) H.precision H.wordWidth s H.t H.u H.s_lt_t.le
  have hs : H.span ≤ s := by have hh := H.span_fit; omega
  have hw1 : 1 ≤ H.wordWidth := by unfold wordWidth executionWidth; omega
  have hv := (Nat.mul_le_mul_right H.wordWidth hs).trans_lt hvolume
  refine ⟨hw,?_,hv⟩
  exact (Nat.le_mul_of_pos_right H.span hw1).trans_lt hv

def ClassAccuracy [NeZero s] (H : ReplicaHaloProblem s) (L : ℕ) (output : List (Fin (A+4))) : Prop :=
  ∀ r : Fin H.Fs.length, ∀ j : Fin (H.offsets L).length,
    PhaseCellInterface.ErrorOn (publishedCellCore (H.originAt L j) L)
      (fun k => (packedIntervalRead H.precision H.wordWidth H.origin
        (output.drop (r.val*H.span*H.wordWidth)) k).re) (H.x r) (1/(2 : ℝ)^H.target)

theorem classAccuracy_preserved [NeZero s] (H : ReplicaHaloProblem s) (K L : ℕ) (hKL : K ≠ L)
    (before after : List (Fin (A+4)))
    (hpreserve : ∀ r : Fin H.Fs.length, ∀ (core : Finset (ZMod s)) (old : ZMod s → ℝ) (error : ℝ),
      (∀ k ∈ core, H.origin ≤ k.val ∧ k.val < H.origin+H.span) →
      (∀ k ∈ core, ∀ j : Fin (H.offsets L).length,
        k.val-H.origin+1 ≤ (H.offsets L)[j.val] ∨ (H.offsets L)[j.val]+L ≤ k.val-H.origin) →
      PhaseCellInterface.ErrorOn core
        (fun k => (packedIntervalRead H.precision H.wordWidth H.origin
          (before.drop (r.val*H.span*H.wordWidth)) k).re) old error →
      PhaseCellInterface.ErrorOn core
        (fun k => (packedIntervalRead H.precision H.wordWidth H.origin
          (after.drop (r.val*H.span*H.wordWidth)) k).re) old error)
    (hbefore : H.ClassAccuracy K before) : H.ClassAccuracy K after := by
  intro r j
  apply hpreserve r (publishedCellCore (H.originAt K j) K) (H.x r) (1/(2 : ℝ)^H.target)
  · intro k hk
    have hh := haloReplicaClassCore_bounds H.t H.band H.origin H.span K H.span_fit j k hk
    exact ⟨hh.1,hh.2.1⟩
  · intro k hk n
    exact haloReplicaClassCore_avoids H.t H.band H.origin H.span K L H.span_fit hKL j k hk n
  · exact hbefore r j

end ReplicaHaloProblem

structure ReplicaLoopBuffers (A : ℕ) where
  savedGather : Stacks 126 A
  solverOutputTail : List (Fin (A+4))
  rhsTail : List (Fin (A+4))
  packedRhsTail : List (Fin (A+4))
  accumulatorTail : List (Fin (A+4))
  keyTail : List (Fin (A+4))
  cacheTail : List (Fin (A+4))
  input : List (Bool ⊕ Bool)
  output : List Bool

structure ReplicaLoopHeaders {s T A : ℕ} (H : ReplicaHaloProblem s) (gather : Fin 126 → Fin T)
    (buffers : ReplicaLoopBuffers A) (S : Stacks T A) : Prop where
  masters : ∀ r ∈ replicaFactoryHeaderCopies, r.1 ≠ 102 → r.1 ≠ 116 → (S.R (gather r.1)).length =
    replicaFactoryHeaderValue (2^15*H.p) (H.stage+1) H.precision H.l s H.t H.u H.band H.Fs.length 0 0 H.wordWidth r.1
  origin : (S.R (gather 111)).length = H.origin
  endpoint : (S.R (gather 113)).length = H.origin+H.span
  width : (S.R (gather 115)).length = H.metadataWidth
  volume : (S.R (gather 123)).length = H.span*H.wordWidth
  source : S.R (gather 124) = H.Fs.flatMap (fun F => cstream A H.wordWidth (packedInterval H.origin H.span F))++buffers.packedRhsTail
  blank : ∀ k : Fin 126, k.val < 31 → S.R (gather k) = []
  fresh : ∀ k ∈ [(88 : Fin 126),89,90,91,92,102,103,104,105,106,107,116,120,122,125], S.R (gather k) = []

namespace ReplicaLoopHeaders
variable {s T A : ℕ} {H : ReplicaHaloProblem s} {gather : Fin 126 → Fin T}
  {buffers : ReplicaLoopBuffers A} {S F : Stacks T A}

theorem of_frame (h : ReplicaLoopHeaders H gather buffers S)
    (hframe : ∀ k : Fin 126, k ≠ 87 → k ≠ 119 → F.R (gather k) = S.R (gather k)) :
    ReplicaLoopHeaders H gather buffers F := by
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩
  · intro r hr h102 h116
    have hf : replicaFactoryHeaderCopies.all (fun r => decide (r.1 ≠ 87 ∧ r.1 ≠ 119)) = true := by decide +kernel
    obtain ⟨h87,h119⟩ := of_decide_eq_true (List.all_eq_true.mp hf r hr)
    rw [hframe r.1 h87 h119]
    exact h.masters r hr h102 h116
  · rw [hframe 111 (by decide) (by decide)]; exact h.origin
  · rw [hframe 113 (by decide) (by decide)]; exact h.endpoint
  · rw [hframe 115 (by decide) (by decide)]; exact h.width
  · rw [hframe 123 (by decide) (by decide)]; exact h.volume
  · rw [hframe 124 (by decide) (by decide)]; exact h.source
  · intro k hk
    rw [hframe k (by intro he; subst k; norm_num at hk) (by intro he; subst k; norm_num at hk)]
    exact h.blank k hk
  · intro k hk
    have h87 : k ≠ 87 := by intro he; subst k; norm_num at hk
    have h119 : k ≠ 119 := by intro he; subst k; norm_num at hk
    rw [hframe k h87 h119]
    exact h.fresh k hk

end ReplicaLoopHeaders
end IntegerMultBounds.MathlibTM2.Mult.PhaseCellToeplitz.ScalarPlacement
