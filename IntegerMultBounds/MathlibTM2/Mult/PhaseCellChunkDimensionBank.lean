module

public import IntegerMultBounds.MathlibTM2.Mult.PhaseCellUnaryPowerChain

@[expose] public section
namespace IntegerMultBounds.MathlibTM2.Mult.PhaseCellToeplitz
open IntegerMultBounds IntegerMultBounds.Machine IntegerMultBounds.MathlibTM2
  IntegerMultBounds.MathlibTM2.Host IntegerMultBounds.MathlibTM2.Stack
  IntegerMultBounds.MathlibTM2.Mult.ShortConv IntegerMultBounds.MathlibTM2.Node

variable {T Q A : ℕ} {P U : Type} {body : P → Pr P T Q A U}

def chunkDimensionBank (base one width tmp saved : Fin T) (ps bs : List (Fin T)) : Pr P T Q A U :=
  .seq (unaryPowerChain base one tmp saved ps) (unaryPowerChain base width tmp saved bs)

def chunkDimensionBankR (K W : ℕ) (ps bs : List (Fin T)) (R : Regs T A) : Regs T A :=
  unaryPowerChainR K W bs (unaryPowerChainR K 1 ps R)

theorem chunkDimensionBankR_off (K W : ℕ) (ps bs : List (Fin T)) (R : Regs T A) (i : Fin T)
    (hi : i ∉ ps++bs) : chunkDimensionBankR K W ps bs R i = R i := by
  simp only [List.mem_append,not_or] at hi
  rw [chunkDimensionBankR,unaryPowerChainR_off K W bs _ i (by intro j hj he; exact hi.2 (he ▸ hj)),
    unaryPowerChainR_off K 1 ps R i (by intro j hj he; exact hi.1 (he ▸ hj))]

theorem chunkDimensionBankR_update_off (K W : ℕ) (ps bs : List (Fin T)) (R : Regs T A)
    (i : Fin T) (word : List (Fin (A+4))) (hi : i ∉ ps++bs) :
    chunkDimensionBankR K W ps bs (Function.update R i word) =
      Function.update (chunkDimensionBankR K W ps bs R) i word := by
  simp only [List.mem_append,not_or] at hi
  rw [chunkDimensionBankR,unaryPowerChainR_update_off K 1 ps R i word hi.1,
    unaryPowerChainR_update_off K W bs _ i word hi.2]
  rfl

/-- The two generated columns supply the exact stage master lengths, including
borrowed power-zero seeds. -/
theorem chunkDimensionBank_lengths (K W : ℕ) (one width : Fin T) (ps bs : List (Fin T))
    (hp : (one::ps).Nodup) (hb : (width::bs).Nodup)
    (hsep : ∀ p ∈ one::ps, ∀ b ∈ width::bs, p ≠ b)
    (R : Regs T A) (hone : (R one).length = 1) (hwidth : (R width).length = W) :
    (∀ i (hi : i < (one::ps).length),
      (chunkDimensionBankR K W ps bs R (one::ps)[i]).length = K^i) ∧
    (∀ i (hi : i < (width::bs).length),
      (chunkDimensionBankR K W ps bs R (width::bs)[i]).length = W*K^i) := by
  constructor
  · intro i hi
    have hm : (one::ps)[i] ∈ one::ps := List.getElem_mem hi
    rw [chunkDimensionBankR,unaryPowerChainR_off K W bs _ _ (by
      intro b hb; exact (hsep _ hm b (by simp [hb])).symm)]
    simpa only [Nat.one_mul] using unaryPowerChainR_seed_length K 1 one ps
      (List.nodup_cons.mp hp).2 (List.nodup_cons.mp hp).1 R hone i hi
  · intro i hi
    apply unaryPowerChainR_seed_length K W width bs (List.nodup_cons.mp hb).2 (List.nodup_cons.mp hb).1
    rw [unaryPowerChainR_off K 1 ps R width (by
      intro p hp; exact hsep p (by simp [hp]) width (by simp))]
    exact hwidth

/-- Both geometric banks are generated by the same product-chain program. -/
theorem chunkDimensionBank_exec (base one width tmp saved : Fin T) (ps bs : List (Fin T))
    (hp : ([base,tmp,saved,one]++ps).Nodup)
    (hb : ([base,tmp,saved,width]++bs).Nodup)
    (hsep : ∀ p ∈ ps, ∀ b ∈ width::bs, p ≠ b)
    (K W : ℕ) (v : HS T Q A U) (S : Stacks T A)
    (hbase : (S.R base).length = K) (hone : (S.R one).length = 1) (hwidth : (S.R width).length = W)
    (hblank : ∀ i ∈ ps++bs, S.R i = []) (htmp : S.R tmp = []) (hsaved : S.R saved = []) :
    ∃ v' n, v'.user = v.user ∧
      n ≤ unaryPowerChainCost K 1 ps.length+unaryPowerChainCost K W bs.length ∧
      Exec body (chunkDimensionBank base one width tmp saved ps bs) (mk v S) n
        (mk v' {S with R := chunkDimensionBankR K W ps bs S.R}) := by
  obtain ⟨v₁,n₁,hu₁,hn₁,he₁⟩ := unaryPowerChain_exec base one tmp saved ps hp K 1 v S hbase hone
    (by intro i hi; exact hblank i (by simp [hi])) htmp hsaved
  let M : Stacks T A := {S with R := unaryPowerChainR K 1 ps S.R}
  have hoff (i : Fin T) (hi : i ∉ ps) : M.R i = S.R i :=
    unaryPowerChainR_off K 1 ps S.R i (by intro j hj he; exact hi (he ▸ hj))
  have hprotected : base ∉ ps ∧ tmp ∉ ps ∧ saved ∉ ps := by
    simp only [List.cons_append,List.nil_append,List.nodup_cons,List.mem_cons,List.not_mem_nil,
      or_false,not_or] at hp
    exact ⟨hp.1.2.2.2,hp.2.1.2.2,hp.2.2.1.2⟩
  obtain ⟨v₂,n₂,hu₂,hn₂,he₂⟩ := unaryPowerChain_exec base width tmp saved bs hb K W v₁ M
    (by rw [hoff base hprotected.1]; exact hbase)
    (by rw [hoff width (by intro hi; exact hsep width hi width (by simp) rfl)]; exact hwidth)
    (by intro b hb; rw [hoff b (by intro hi; exact hsep b hi b (by simp [hb]) rfl)]; exact hblank b (by simp [hb]))
    (by rw [hoff tmp hprotected.2.1]; exact htmp)
    (by rw [hoff saved hprotected.2.2]; exact hsaved)
  exact ⟨v₂,n₁+n₂,hu₂.trans hu₁,Nat.add_le_add hn₁ hn₂,Exec.seq he₁ he₂⟩

def releaseChunkDimensionBank (ps bs : List (Fin T)) : Pr P T Q A U :=
  .seq (clearWords bs) (clearWords ps)

/-- Release in reverse allocation order, restoring both banks and every spectator. -/
theorem releaseChunkDimensionBank_exec (K W : ℕ) (ps bs : List (Fin T))
    (hp : ps.Nodup) (hb : bs.Nodup) (hsep : ∀ p ∈ ps, ∀ b ∈ bs, p ≠ b)
    (v : HS T Q A U) (S : Stacks T A) (hblank : ∀ i ∈ ps++bs, S.R i = []) :
    ∃ v', v'.user = v.user ∧
      Exec body (releaseChunkDimensionBank ps bs) (mk v {S with R := chunkDimensionBankR K W ps bs S.R})
        ((2*unaryPowerChainVolume K W bs.length+2*bs.length+1)+
          (2*unaryPowerChainVolume K 1 ps.length+2*ps.length+1)) (mk v' S) := by
  let M : Stacks T A := {S with R := unaryPowerChainR K 1 ps S.R}
  obtain ⟨v₁,hu₁,he₁⟩ := unaryPowerChain_release_exec K W bs hb v M (by
    intro b hb
    rw [show M.R b = S.R b from unaryPowerChainR_off K 1 ps S.R b (by
      intro p hp; exact hsep p hp b hb)]
    exact hblank b (by simp [hb]))
  obtain ⟨v₂,hu₂,he₂⟩ := unaryPowerChain_release_exec K 1 ps hp v₁ S
    (by intro p hp; exact hblank p (by simp [hp]))
  exact ⟨v₂,hu₂.trans hu₁,Exec.seq he₁ he₂⟩

end IntegerMultBounds.MathlibTM2.Mult.PhaseCellToeplitz
